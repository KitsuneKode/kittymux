def _demo_world(tmp: str, state: str) -> str | None:
    """Build tools/demo_world.py's synthetic usage (a fake home the collectors read, a week of history) under `tmp`; returns the fake home, or None when it cannot."""
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location("kittymux_demo_world", os.path.join(HOME_DIR, "tools", "demo_world.py"))
        dw = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(dw)
        from pathlib import Path
        home, now = Path(tmp) / "world" / "home", time.time()
        for fn in (dw.codex, dw.claude, dw.cursor, dw.devin):
            fn(home, now)
        dw.history(Path(state), now)
        return str(home)
    except Exception:
        return None


def _demo_events(sock: str, pid: int, state: str) -> None:
    """Two inbox events the demo's own agents do not produce by themselves (a limit and a finished run), bound to the demo's real windows so Jump works."""
    rc, out = _run(["kitty", "@", "--to", sock, "ls"], 4)
    if rc != 0:
        return
    try:
        data = json.loads(out)
    except ValueError:
        return
    win = {t.get("title"): (t.get("windows") or [{}])[0].get("id") for o in data for t in o.get("tabs", [])}
    now = time.time()
    for kind, agent, tab, title, age, extra in (("limit", "codex", "codex", "5h usage limit reached", 540, {"reset_at": now + 3 * 3600 + 50 * 60}),
                                                  ("done", "agy", "antigravity", "Finished in 4m 12s", 250, {})):
        if win.get(tab):
            kittymux_inbox.add(state, kittymux_inbox.make_event(kind, agent, win[tab], "screen", now - age, pid=pid, tab=tab, title=title, **extra))


def demo(argv: list[str]) -> int:
    edge = "bottom" if "--bottom" in argv else "left"
    if not shutil.which("kitty"):
        print("kitty not found", file=sys.stderr)
        return 1
    tmp = tempfile.mkdtemp(prefix="kittymux-demo-")
    cfg, state = os.path.join(tmp, "cfg"), os.path.join(tmp, "state")
    os.makedirs(cfg)
    os.makedirs(state, mode=0o700)
    import glob
    for path in [os.path.join(HOME_DIR, "python", "tab_bar.py"), os.path.join(HOME_DIR, "python", "window_title_bar.py")] + sorted(glob.glob(os.path.join(HOME_DIR, "python", "kittymux_*.py"))):
        os.symlink(path, os.path.join(cfg, os.path.basename(path)))
    tpl = open(os.path.join(HOME_DIR, "kittymux-keys.conf.tpl"), encoding="utf-8").read()
    open(os.path.join(cfg, "kittymux-keys.conf"), "w").write(tpl.replace("@KITTYMUX_HOME@", HOME_DIR))
    ltpl = open(os.path.join(HOME_DIR, "kittymux-leader.conf.tpl"), encoding="utf-8").read()
    open(os.path.join(cfg, "kittymux-leader.conf"), "w").write(
        ltpl.replace("@KITTYMUX_HOME@", HOME_DIR).replace("@KITTYMUX_LEADER@", "ctrl+space"))
    open(os.path.join(cfg, "theme.conf"), "w").write(DEMO_THEME)
    env = dict(os.environ, KITTY_CONFIG_DIRECTORY=cfg, KITTYMUX_STATE=state, KITTYMUX_NOTIFY="0")
    world = _demo_world(tmp, state)                            # synthetic usage for the panel's Usage view: nothing of yours is read or shown
    if world:
        env["KITTYMUX_USAGE_HOME"] = world
    fam = _fc_families()
    font_conf = "font_size 12\n"
    for cand in ("JetBrainsMono Nerd Font Mono", "CaskaydiaCove Nerd Font Mono", "FiraCode Nerd Font Mono",
                 "Hack Nerd Font Mono", "JetBrains Mono"):
        if cand.lower() in fam:
            font_conf += f"font_family {cand}\n"
            break
    if "symbols nerd font mono" in fam:
        font_conf += "symbol_map U+e000-U+e00a,U+e0a0-U+e0a3,U+e0b0-U+e0c8,U+e200-U+e2a9,U+e300-U+e3e3," \
                     "U+e5fa-U+e6b7,U+e700-U+e8ef,U+ea60-U+ec1e,U+ed00-U+efce,U+f000-U+f2ff,U+f300-U+f381," \
                     "U+f400-U+f533,U+f0001-U+f1af0 Symbols Nerd Font Mono\n"
    if "kittymux icons" not in fam or "--own-icon-font" in argv:
        # brand logos live in our own icon font — expose it to this window only
        data = os.path.join(tmp, "data")
        os.makedirs(os.path.join(data, "fonts"))
        shutil.copy(os.path.join(HOME_DIR, "assets", "kittymux-icons.ttf"), os.path.join(data, "fonts"))
        user_fonts = os.path.expanduser("~/.local/share/fonts")
        if os.path.isdir(user_fonts):
            # the user's fonts, minus an installed copy of OUR icon font: two files of one family and kitty may
            # pick the older (without the newest glyphs)
            os.makedirs(os.path.join(data, "fonts", "user"))
            for name in os.listdir(user_fonts):
                if name != "kittymux-icons.ttf":
                    os.symlink(os.path.join(user_fonts, name), os.path.join(data, "fonts", "user", name))
        env["XDG_DATA_HOME"] = data
    open(os.path.join(cfg, "kitty.conf"), "w").write(
        font_conf + "allow_remote_control socket-only\nlisten_on unix:/tmp/mykitty\n"
        "include theme.conf\n"
        f"include {cfg}/kittymux-keys.conf\ninclude {cfg}/kittymux-leader.conf\n"
        f"include {HOME_DIR}/kittymux.conf\ntab_bar_edge {edge}\nwindow_padding_width 10\n"
        f"geninclude {HOME_DIR}/python/kittymux_layout.py\n")      # last: the collapse button / layout keys need it
    project = os.path.join(tmp, "project")                     # a tiny project for the clickable file:line demo
    os.makedirs(os.path.join(project, "src"))
    for rel, n in (("src/app.py", 60), ("src/util.py", 30), ("README.md", 10)):
        with open(os.path.join(project, rel), "w") as f:
            f.write("".join(f"line {i} of {rel}\n" for i in range(1, n + 1)))
    twins = os.path.join(tmp, "twins")                         # two repos with an `app` folder each: same tab title, different projects
    for repo in ("web", "api"):
        os.makedirs(os.path.join(twins, repo, "app"))
        if shutil.which("git"):
            subprocess.run(["git", "init", "-q", "-b", "main", os.path.join(twins, repo)], capture_output=True)
    otpl = open(os.path.join(HOME_DIR, "open-actions.conf.tpl"), encoding="utf-8").read()
    open(os.path.join(cfg, "open-actions.conf"), "w").write(otpl.replace("@KITTYMUX_HOME@", HOME_DIR))
    session = os.path.join(tmp, "demo.kitty")
    open(session, "w").write(DEMO_SESSION.format(home=os.path.expanduser("~"), project=project, twins=twins))

    banner()
    print(c("1", "kittymux demo") + " — an isolated window; your config is untouched.\n")
    proc = subprocess.Popen(["kitty", "--class", "kittymux-demo", "--session", session], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sock = f"unix:/tmp/mykitty-{proc.pid}"
    for _ in range(60):
        if os.path.exists(sock[5:]):
            break
        time.sleep(0.1)
    time.sleep(1.5)
    _demo_events(sock, proc.pid, state)

    print("  try:")
    print(f"    {c('1', 'ctrl+alt+b')}       sidebar deck — hover, click, live preview; / to search, t to promote a pane")
    print(f"    {c('1', 'ctrl+alt+y')}       jump to the agent that is waiting on you")
    print(f"    {c('1', 'ctrl+alt+shift+space')}  command palette — type to find a tab, an agent that needs you, a conversation or an action; ⏎ does it")
    print(f"    {c('1', 'ctrl+alt+b')} then {c('1', 'u')} usage (provider tiles, gauges with a pace tick, a week of tokens) · {c('1', 'i')} inbox (Jump, Dismiss) · {c('1', 'a')} back — made-up numbers")
    print(f"    {c('1', 'ctrl+alt+/')}       every key, gesture and command — just type to search, esc closes")
    print(f"    {c('1', 'ctrl+space')} then {c('1', '?')}   leader mode card")
    print(f"  in the {c('1', 'panes')} tab:")
    print(f"    {c('1', 'ctrl+alt+e')}       number every pane, press a digit    {c('1', 'ctrl+alt+shift+1..4')}  jump straight to pane N")
    print(f"    {c('1', 'ctrl+alt+d')}       turn the focused pane into its own tab    {c('1', 'ctrl+alt+shift+c')}  show pane title bars (drag them)")
    print(f"  in the {c('1', 'file-refs')} tab: {c('1', 'ctrl+shift+click')} src/app.py:42:7 — opens your editor at that line")
    print(f"  in the two {c('1', 'app')} tabs: the same title, different projects — the bar says which (`kittymux features` turns pieces off)")
    print(f"  in the {c('1', 'scrollback')} tab: {c('1', 'ctrl+alt+PgUp / PgDn')} page · {c('1', 'ctrl+alt+Home / End')} oldest / live · {c('1', 'ctrl+alt+[')} {c('1', ']')} prompts")
    print(f"  the bar: drag its right edge to resize (try a fast flick) · click « to collapse · right-click a tab to peek")
    print(f"  from a pane here:  {c('1', 'kittymux dim on')} (needs shader-slang) · {c('1', 'kittymux screenshot')} · {c('1', 'kittymux layout pick')}")
    print(f"\n  status is read from each agent's screen — ! waiting on you, a spinner while it works — and from `mux-status` hooks if you add them.")
    print("  close the kitty window to end the demo.\n")
    try:
        proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
    shutil.rmtree(tmp, ignore_errors=True)
    return 0


# ── layout ───────────────────────────────────────────────────────────────────
def _owned_socket(path: str) -> bool:
    """A kitty socket we may trust: a real socket owned by us (anyone can create files
    in /tmp — never send window contents to a socket someone else planted)."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    return stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid()


def _own_kitty_socket() -> str | None:
    """The kitty this process was started FROM (kitty spawns key-bound commands, so its pid names the socket even when the environment is stale; then the environment hints),
    or None when we were not started inside a kitty at all (a window-manager bind, a plain terminal)."""
    ppid = str(os.getppid())
    for d in _socket_dirs():
        if _owned_socket(f"{d}/mykitty-{ppid}"):
            return f"unix:{d}/mykitty-{ppid}"
    env = os.environ.get("KITTY_LISTEN_ON", "")
    if env.startswith("unix:") and _owned_socket(env[5:]):
        return env
    pid = os.environ.get("KITTY_PID", "")
    if pid.isdigit():
        for d in _socket_dirs():
            if _owned_socket(f"{d}/mykitty-{pid}"):
                return f"unix:{d}/mykitty-{pid}"
    return None


def _target_socket() -> str | None:
    """The kitty instance this command was launched from.

    Order matters: an explicit KITTYMUX_TARGET; then the kitty we were started from; finally the newest socket we own."""
    explicit = os.environ.get("KITTYMUX_TARGET", "")
    if explicit.startswith("unix:") and _owned_socket(explicit[5:]):
        return explicit
    own = _own_kitty_socket()
    if own:
        return own
    import glob
    socks = sorted((g for d in _socket_dirs() for g in glob.glob(os.path.join(d, "mykitty-*")) if _owned_socket(g)),
                   key=lambda g: os.stat(g).st_mtime, reverse=True)
    return f"unix:{socks[0]}" if socks else None


def _socket_pid(sock: str) -> int | None:
    tail = sock.rsplit("-", 1)[-1]
    return int(tail) if tail.isdigit() else None


def _notify(msg: str) -> None:
    if os.environ.get("KITTYMUX_NOTIFY") == "0" or os.path.exists(os.path.join(STATE, "notify-off")):
        return                                     # same off-switch as the agent notifications
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "kittymux", "-t", "1400", "--", "tab bar", msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def layout(argv: list[str]) -> int:
    cmd = argv[0] if argv else "show"
    arg = argv[1] if len(argv) > 1 else ""
    sdir = kittymux_layout.state_dir()
    sock = _target_socket()
    pid = _socket_pid(sock) if sock else None
    if pid is None:
        print("kittymux layout: no kitty remote-control socket found "
              "(set allow_remote_control socket-only and listen_on unix:${XDG_RUNTIME_DIR}/mykitty in kitty.conf)", file=sys.stderr)
        return 1
    current = kittymux_layout.base_layout(sdir, pid, CFG)

    if cmd == "show":
        saved = kittymux_layout.load(sdir, pid)
        print(f"{kittymux_layout.describe(current)}  ({'saved for this kitty' if saved else 'from your kitty.conf'})")
        print("presets: " + ", ".join(kittymux_layout.PRESETS))
        return 0
    if cmd == "default":
        if arg == "clear":
            kittymux_layout.clear_default(sdir)
            print("default cleared — new kitty windows follow your kitty.conf until you choose a layout")
        else:
            kittymux_layout.pin_default(sdir, current)
            print(f"pinned as the default for new kitty windows: {kittymux_layout.describe(current)}")
        return 0
    if cmd == "pick":
        return _layout_pick(sock, sdir, pid, current)
    try:
        new = kittymux_layout.apply_command(current, cmd, arg)
    except ValueError as e:
        print(f"kittymux layout: {e}", file=sys.stderr)
        return 2
    return _apply_layout(sock, sdir, pid, new)


def _apply_layout(sock: str, sdir: str, pid: int, new) -> int:
    kittymux_layout.save(sdir, pid, new)
    rc, _ = _run(["kitty", "@", "--to", sock, "load-config"], 6)   # this instance only
    label = kittymux_layout.describe(new)
    if rc != 0:
        print(f"saved ({label}) but could not reload {sock} — reload it with ctrl+shift+alt+r", file=sys.stderr)
        return 1
    print(label)
    _notify(label)
    return 0


def _layout_pick(sock: str, sdir: str, pid: int, current) -> int:
    if not shutil.which("fzf"):
        print("fzf not found", file=sys.stderr)
        return 1
    here = kittymux_layout.describe(current)
    rows = [f"{name:<14}\t{desc}" for name, (lay, desc) in kittymux_layout.PRESETS.items()]
    colors = kittymux_theme.fzf_args(kittymux_theme.palette_from_kitty(sock))
    p = subprocess.run(
        ["fzf", "--ansi", "--layout=reverse", "--height=100%", "--border=rounded", "--margin=1,2",
         "--padding=1,2", "--delimiter=\t", "--with-nth=1,2", "--no-sort", "--cycle",
         "--prompt=  tab bar › ", f"--header=now: {here}", "--header-first",
         "--footer=enter: apply   esc: cancel", *colors],
        input="\n".join(rows), text=True, capture_output=True)
    if p.returncode != 0 or not p.stdout.strip():
        return 0
    name = p.stdout.split("\t", 1)[0].strip()
    return _apply_layout(sock, sdir, pid, kittymux_layout.apply_command(current, "preset", name))


# ── inbox ────────────────────────────────────────────────────────────────────
_GLYPH = {"needs-you": "!", "warn": "⊘", "info": "·"}


def format_event(ev: dict, now: float, width: int = 110) -> str:
    """One inbox line: `! 12:03  claude  permission   <tab>  <what it said>  [agent+screen]`."""
    clock = time.strftime("%H:%M", time.localtime(float(ev.get("t", 0))))
    mark = _GLYPH.get(ev.get("severity", "info"), "·") if ev.get("status") == "unread" else " "
    extra = ""
    if ev.get("kind") == "limit" and ev.get("reset_at"):
        left = max(0, int(ev["reset_at"] - now))
        extra = f" (resets in {left // 3600}h {left % 3600 // 60:02d}m)" if left else " (reset time passed)"
    if ev.get("kind") == "done" and ev.get("confidence") == "low":
        extra += " (judged from the screen)"
    said = ev.get("body") or ev.get("title") or ""
    srcs = "+".join(ev.get("sources", []))
    count = f" ×{ev['count']}" if ev.get("count", 1) > 1 else ""
    line = "%s %s  %-9s %-11s %-22s %s%s%s  [%s]" % (mark, clock, ev.get("agent", "")[:9], ev.get("kind", ""), (ev.get("tab") or "")[:22], said, extra, count, srcs)
    return line[:width]


def _inbox_socket(pid) -> str | None:
    for d in _socket_dirs():
        path = os.path.join(d, f"mykitty-{pid}")
        if _owned_socket(path):
            return f"unix:{path}"
    return None


def inbox_jump(ev: dict) -> int:
    """Focus the window an event is about (kitty remote control, then the window manager), and mark that window's events read."""
    sock = _inbox_socket(ev.get("pid"))
    if sock is None or not str(ev.get("w", "")).isdigit():
        print("kittymux inbox: that kitty is no longer running (or has no control socket)", file=sys.stderr)
        return 1
    rc, _ = _run(["kitty", "@", "--to", sock, "focus-window", "--match", f"id:{ev['w']}"], 4)
    if rc != 0:
        print("kittymux inbox: that window is gone", file=sys.stderr)
        return 1
    if shutil.which("hyprctl"):
        _run(["hyprctl", "dispatch", "focuswindow", f"pid:{ev.get('pid')}"], 3)
    kittymux_inbox.ack(kittymux_layout.state_dir(), time.time(), window=ev["w"], pid=ev.get("pid"))
    return 0


def inbox(argv: list[str]) -> int:
    sdir = kittymux_layout.state_dir()
    now = time.time()
    cmd = argv[0] if argv and not argv[0].startswith("-") else "list"
    rest = argv[1:] if argv and not argv[0].startswith("-") else argv
    if cmd in ("ack", "read"):
        ids = [a for a in rest if not a.startswith("-")]
        if "--all" in rest:
            ids = [e["id"] for e in kittymux_inbox.load(sdir) if e.get("status") == "unread"]
        if not ids:
            print("usage: kittymux inbox ack ID… | --all", file=sys.stderr)
            return 2
        kittymux_inbox.ack(sdir, now, ids=ids)
        print(f"{OK} marked {len(ids)} read")
        return 0
    if cmd == "clear":
        kittymux_inbox.clear(sdir, now, everything="--all" in rest)
        print(f"{OK} cleared")
        return 0
    if cmd == "jump":
        events = [e for e in kittymux_inbox.load(sdir) if e.get("status") == "unread"]
        ids = [a for a in rest if not a.startswith("-")]
        target = next((e for e in reversed(kittymux_inbox.load(sdir)) if ids and e["id"] == ids[0]), None) if ids else None
        if target is None and not ids:                  # the most pressing unread one: needs-you first, newest first
            ranked = sorted(events, key=lambda e: (e.get("severity") != "needs-you", -float(e.get("t", 0))))
            target = ranked[0] if ranked else None
        if target is None:
            print("kittymux inbox: nothing to jump to", file=sys.stderr)
            return 1
        return inbox_jump(target)
    if cmd == "ledger":
        summ = kittymux_ledger.summary(kittymux_inbox.load(sdir), now)
        if "--json" in rest:
            print(json.dumps(summ, indent=1))
        else:
            print(kittymux_ledger.format_text(summ))
        return 0
    if cmd == "waybar" or "--waybar" in argv:
        print(json.dumps(kittymux_launcher.waybar_status(kittymux_inbox.load(sdir), now), ensure_ascii=False))
        return 0
    if cmd == "watch":
        seen, last = set(e["id"] for e in kittymux_inbox.load(sdir)), 0.0
        try:
            while True:
                try:
                    mtime = os.stat(kittymux_inbox.store_path(sdir)).st_mtime
                except OSError:
                    mtime = 0.0
                if mtime != last:
                    last = mtime
                    for e in kittymux_inbox.load(sdir):
                        if e["id"] not in seen:
                            seen.add(e["id"])
                            print(json.dumps(e, sort_keys=True), flush=True)
                time.sleep(0.5)
        except KeyboardInterrupt:
            return 0
    if cmd != "list":
        print("usage: kittymux inbox [--all] [--json] [--limit N] | ack | clear | jump | watch | ledger", file=sys.stderr)
        return 2
    show_all, as_json, limit = "--all" in rest, "--json" in rest, 30
    if "--limit" in rest:
        try:
            limit = int(rest[rest.index("--limit") + 1])
        except (ValueError, IndexError):
            print("kittymux inbox: --limit needs a number", file=sys.stderr)
            return 2
    events = kittymux_inbox.load(sdir)
    if not show_all:
        events = [e for e in events if e.get("status") == "unread"]
    events = list(reversed(events))[:max(1, limit)]
    if as_json:
        print(json.dumps(kittymux_inbox.snapshot(kittymux_inbox.load(sdir), now), indent=1, sort_keys=True))
        return 0
    if not events:
        print("inbox is empty" + ("" if show_all else " (nothing unread; --all shows what you have already seen)"))
        return 0
    for e in events:
        line = format_event(e, now)
        print(c("1", line) if e.get("status") == "unread" and e.get("severity") == "needs-you" else line)
    return 0


# ── sessions: save/restore with agent resume, templates ──────────────────────
TEMPLATE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,59}$")
CHECK_TTL_S = 12 * 3600


def _resume_agents() -> dict:
    user = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kittymux", "resume.json")
    return kittymux_resume.load_agents(os.path.join(HOME_DIR, "assets", "resume-agents.json"), user)


def _sessions_dir() -> str:
    return os.path.join(kittymux_layout.state_dir(), "sessions")


def probe_agent(name: str, d: dict, which=shutil.which, run=subprocess.run) -> tuple[bool, str, str]:
    """(ok, detail, exe): does the installed CLI's own --help mention what the definition needs? Nothing is enabled on a guess."""
    exe = which(name) or next((which(a) for a in d.get("names", []) if which(a)), None)
    if not exe:
        return False, "not installed", ""
    probe = d.get("probe") or {}
    try:
        out = run([exe, *probe.get("args", ["--help"])], capture_output=True, text=True, timeout=8, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return False, "could not run it", exe
    text = (out.stdout or "") + (out.stderr or "")
    missing = [t for t in probe.get("expect", []) if t not in text]
    return (not missing), ("its --help has the resume flags" if not missing else "its --help does not mention: " + ", ".join(missing)), exe


def agent_enabled(name: str, agents: dict, cache_path: str | None = None, now: float | None = None, probe=probe_agent) -> bool:
    """Probe result for an agent, cached for 12 h per executable (path + mtime): the probe runs the CLI, so not on every call."""
    cache_path = cache_path or os.path.join(kittymux_layout.state_dir(), "resume-check.json")
    now = time.time() if now is None else now
    try:
        with open(cache_path, encoding="utf-8") as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    d = agents.get(name)
    if d is None:
        return False
    exe = shutil.which(name) or next((shutil.which(a) for a in d.get("names", []) if shutil.which(a)), None)
    try:
        stamp = [exe, os.stat(exe).st_mtime] if exe else [None, 0]
    except OSError:
        stamp = [exe, 0]
    hit = cache.get(name)
    if hit and hit.get("stamp") == stamp and now - hit.get("at", 0) < CHECK_TTL_S:
        return bool(hit.get("ok"))
    ok, detail, _ = probe(name, d)
    cache[name] = {"ok": ok, "detail": detail, "stamp": stamp, "at": now}
    try:
        os.makedirs(os.path.dirname(cache_path), mode=0o700, exist_ok=True)
        tmp = cache_path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(cache, f)
        os.replace(tmp, cache_path)
    except OSError:
        pass
    return ok


def _live_windows(sock: str) -> list[dict]:
    rc, out = _run(["kitty", "@", "--to", sock, "ls"], 6)
    if rc != 0:
        return []
    try:
        data = json.loads(out)
    except ValueError:
        return []
    wins = []
    for osw in data:
        for tab in osw.get("tabs", []):
            for w in tab.get("windows", []):
                wins.append({"id": w["id"], "cwd": w.get("cwd", ""), "tab": tab.get("title", ""), "user_vars": w.get("user_vars") or {},
                             "fg": [{"pid": p.get("pid"), "cmdline": p.get("cmdline") or []} for p in w.get("foreground_processes", [])]})
    return wins


def _run_in(argv: list[str], cwd: str, seconds: float = 8.0) -> str | None:
    """stdout of a read-only agent CLI query run in `cwd` (opencode's session list), or None. Only ever called with argv built by kittymux_resume."""
    try:
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=seconds, stdin=subprocess.DEVNULL)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def _session_plan(sock: str) -> list[dict]:
    agents = _resume_agents()
    claude_home = os.environ.get("KITTYMUX_CLAUDE_HOME") or os.path.expanduser("~/.claude")
    return kittymux_resume.build_plan(_live_windows(sock), agents, claude_home, enabled=lambda n: agent_enabled(n, agents), home=os.path.expanduser("~"), run=_run_in)


def sessions_prepare(sock: str, windows=None, plan=None) -> list[dict]:
    """Mark every agent window with what its restore needs, as kitty user variables — kitty's own save serialises them as `--var=` lines, which makes
    the saved file self-describing. Windows that carried a mark but no longer run an agent are cleared."""
    windows = windows if windows is not None else _live_windows(sock)
    plan = plan if plan is not None else _session_plan(sock)
    marked = set()
    for e in plan:
        marked.add(e["id"])
        sid = e["session_id"] if e["mode"] == "exact" else ""
        _run(["kitty", "@", "--to", sock, "set-user-vars", "--match", f"id:{e['id']}", f"kittymux_agent={e['agent']}", f"kittymux_resume={e['mode']}",
              f"kittymux_sid={sid}"], 4)
    for w in windows:
        if w["id"] not in marked and any(k in w["user_vars"] for k in ("kittymux_sid", "kittymux_resume")):
            _run(["kitty", "@", "--to", sock, "set-user-vars", "--match", f"id:{w['id']}", "kittymux_agent=", "kittymux_resume=", "kittymux_sid="], 4)
    return plan


def prompt_wrapper() -> list[str]:
    return [os.path.join(HOME_DIR, "bin", "kittymux"), "resume-prompt"]


def rewrite_file(path: str, direct: bool = False) -> list[str]:
    """Rewrite one saved session file in place (0600, atomic). Returns what changed. By default each agent window comes back ASKING (`kittymux resume-prompt`)
    whether to resume its conversation; `direct` writes the resume command itself (it resumes without asking)."""
    agents = _resume_agents()
    with open(path, encoding="utf-8") as f:
        text = f.read()
    new, report = kittymux_resume.rewrite_session(text, agents, enabled=lambda n: agent_enabled(n, agents), wrapper=None if direct else prompt_wrapper())
    if new != text:
        tmp = path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(new)
        os.replace(tmp, path)
    else:
        os.chmod(path, 0o600)
    return report


def _wait_for_write(paths_before: dict, directory: str, seconds: float = 6.0) -> list[str]:
    """kitty's save action is asynchronous: wait for session files in `directory` to appear or change."""
    import glob
    deadline = time.time() + seconds
    while time.time() < deadline:
        changed = [p for p in glob.glob(os.path.join(directory, "*.kitty-session")) if os.stat(p).st_mtime != paths_before.get(p)]
        if changed:
            time.sleep(0.4)                                   # let kitty finish writing
            return changed
        time.sleep(0.2)
    return []


def sessions_save(argv: list[str]) -> int:
    name = next((a for a in argv if not a.startswith("-")), "")
    if name and not TEMPLATE_NAME.match(name):
        print("kittymux sessions: a session name is letters, digits, . _ - (up to 60)", file=sys.stderr)
        return 2
    sock = _target_socket()
    if not sock:
        print("kittymux sessions: no kitty remote-control socket found", file=sys.stderr)
        return 1
    sdir = _sessions_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    plan = sessions_prepare(sock)
    name = name or time.strftime("saved-%Y%m%d-%H%M%S")
    import glob
    before = {p: os.stat(p).st_mtime for p in glob.glob(os.path.join(sdir, "*.kitty-session"))}
    match = "all" if "--all" in argv else "state:focused_os_window"
    args = " ".join(shlex.quote(a) for a in ("--save-only", "--use-foreground-process", "--base-dir", sdir, f"--match={match}", f"{name}.kitty-session"))
    rc, _ = _run(["kitty", "@", "--to", sock, "action", "save_as_session", args], 8)
    changed = _wait_for_write(before, sdir) if rc == 0 else []
    if not changed:
        print("kittymux sessions: kitty did not write the session file", file=sys.stderr)
        return 1
    report = []
    for p in changed:
        report += rewrite_file(p, direct="--direct" in argv)
    path = os.path.join(sdir, f"{name}.kitty-session")
    print(f"{OK} saved {path}")
    for line in report:
        print(f"    {line}")
    skipped = [e for e in plan if not e["resume"]]
    for e in skipped:
        print(f"  {WARN} window {e['id']} ({e['agent']}): restored as a new conversation — {e['why']}")
    return 0


def sessions_autosave(keep: int = 5) -> int:
    """`autosave-<kitty pid>.kitty-session`, silently; older autosaves are pruned to the newest `keep`. Run by the scanner (kittymux_scan._maybe_autosave)."""
    import glob
    sock = _target_socket()
    pid = _socket_pid(sock) if sock else None
    if pid is None:
        return 1
    import io
    from contextlib import redirect_stderr, redirect_stdout
    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
        rc = sessions_save([f"autosave-{pid}", "--all"])
    old = sorted(glob.glob(os.path.join(_sessions_dir(), "autosave-*.kitty-session")), key=os.path.getmtime, reverse=True)[keep:]
    for p in old:
        try:
            os.unlink(p)
        except OSError:
            pass
    return rc


def sessions_list(argv: list[str]) -> int:
    sock = _target_socket()
    if not sock:
        print("kittymux sessions: no kitty remote-control socket found", file=sys.stderr)
        return 1
    plan = _session_plan(sock)
    shown = [dict(e, argv=kittymux_journal.redact_argv(e["argv"]), resume=kittymux_journal.redact_argv(e["resume"]) if e["resume"] else e["resume"]) for e in plan]
    if "--json" in argv:
        print(json.dumps(shown, indent=1, sort_keys=True))                    # output that may be pasted: secret-looking values hidden
        return 0
    if not plan:
        print("no agent windows in this kitty")
        return 0
    plan = shown
    for e in plan:
        how = {"exact": "exact session", "latest": "latest in dir", "none": "new session"}[e["mode"]]
        cmd = shlex.join(e["resume"]) if e["resume"] else "(restored as saved)"
        print("  win %-5s %-13s %-14s %-24s %s" % (e["id"], e["agent"], how, e["cwd"].replace(os.path.expanduser("~"), "~")[-24:], cmd))
        if e["mode"] == "none":
            print(c("2", "      " + e["why"]))
    return 0


def sessions_check(argv: list[str]) -> int:
    agents = _resume_agents()
    bad = 0
    print(c("1", "resume support, probed against each installed CLI's own --help"))
    for name, d in sorted(agents.items()):
        ok, detail, exe = probe_agent(name, d)
        shown = OK if ok else (WARN if detail == "not installed" else BAD)
        tag = "verified by the author" if d.get("verified") else "from public docs (enabled only because this probe passes)"
        print(f"  {shown} {name:<13} {detail}" + (c("2", f"  [{tag}]") if ok else ""))
        if not ok and detail != "not installed":
            bad += 1
    print(c("2", "\n  An agent not listed here (gemini, goose, qwen, kimi, …) has no verified resume definition: add one to ~/.config/kittymux/resume.json (see docs/sessions.md)."))
    return 1 if bad else 0


def sessions_rewrite(argv: list[str]) -> int:
    sdir = _sessions_dir()
    if "--recent" in argv:
        import glob
        seconds = 20.0
        paths = [p for p in glob.glob(os.path.join(sdir, "*.kitty-session"))]
        before = {p: 0.0 for p in paths}
        deadline = time.time() + 6.0
        recent = []
        while time.time() < deadline:
            recent = [p for p in glob.glob(os.path.join(sdir, "*.kitty-session")) if time.time() - os.stat(p).st_mtime < seconds]
            if recent:
                time.sleep(0.4)
                break
            time.sleep(0.2)
        files = recent
    else:
        files = [a for a in argv if not a.startswith("-")]
    if not files:
        print("kittymux sessions: no session file to rewrite", file=sys.stderr)
        return 1
    for p in files:
        try:
            for line in rewrite_file(p, direct="--direct" in argv):
                print(f"  {line}")
        except OSError as e:
            print(f"kittymux sessions: {p}: {e}", file=sys.stderr)
            return 1
    return 0


def _find_session(arg: str) -> str | None:
    import glob
    sdir = _sessions_dir()
    if arg in ("", "last"):
        files = sorted(glob.glob(os.path.join(sdir, "*.kitty-session")), key=os.path.getmtime, reverse=True)
        return files[0] if files else None
    path = arg if os.path.sep in arg else os.path.join(sdir, arg if arg.endswith(".kitty-session") else arg + ".kitty-session")
    return path if os.path.isfile(path) else None


def sessions_restore(argv: list[str]) -> int:
    path = _find_session(next((a for a in argv if not a.startswith("-")), "last"))
    if not path:
        print("kittymux sessions: no such saved session (kittymux sessions save NAME first)", file=sys.stderr)
        return 1
    sock = _target_socket()
    if sock and "--new-window" not in argv:
        rc, _ = _run(["kitty", "@", "--to", sock, "action", "goto_session", path], 8)          # kitty's own session switch
        if rc == 0:
            print(f"{OK} restored {path} (goto_session)")
            return 0
    subprocess.Popen(["kitty", "--session", path], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(f"{OK} opening {path} in a new kitty")
    return 0


def _template_dirs() -> list[str]:
    user = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kittymux", "templates")
    return [user, os.path.join(HOME_DIR, "assets", "templates")]


def list_templates() -> dict:
    out = {}
    for d in reversed(_template_dirs()):                       # the user's directory wins
        try:
            for f in sorted(os.listdir(d)):
                if f.endswith(".kitty-session"):
                    out[f[:-len(".kitty-session")]] = os.path.join(d, f)
        except OSError:
            pass
    return out


def sessions_new(argv: list[str]) -> int:
    opts, pos, it = {"template": "agent", "agent": "claude", "cwd": os.getcwd(), "agent2": "codex"}, [], iter(argv)
    for a in it:
        if a in ("--template", "--agent", "--cwd", "--agent2"):
            opts[a[2:]] = next(it, "")
        elif a == "--force":
            continue
        elif a.startswith("-"):
            print("usage: kittymux sessions new NAME [--template T] [--agent A] [--cwd DIR]", file=sys.stderr)
            return 2
        else:
            pos.append(a)
    if len(pos) != 1 or not TEMPLATE_NAME.match(pos[0]):
        print("usage: kittymux sessions new NAME [--template T] [--agent A] [--cwd DIR]   (NAME: letters, digits, . _ -)", file=sys.stderr)
        return 2
    templates = list_templates()
    if opts["template"] not in templates:
        print(f"kittymux sessions: no template '{opts['template']}' (have: {', '.join(sorted(templates))})", file=sys.stderr)
        return 2
    for key in ("agent", "agent2"):
        if not TEMPLATE_NAME.match(opts[key] or ""):
            print(f"kittymux sessions: --{key} must be a command name", file=sys.stderr)
            return 2
    cwd = os.path.abspath(os.path.expanduser(opts["cwd"]))
    if not os.path.isdir(cwd):
        print(f"kittymux sessions: {cwd} is not a directory", file=sys.stderr)
        return 2
    with open(templates[opts["template"]], encoding="utf-8") as f:
        text = f.read()
    shell = os.environ.get("SHELL") or "/bin/sh"
    body = kittymux_resume.render_template(text, {"NAME": pos[0], "CWD": cwd, "AGENT": opts["agent"], "AGENT2": opts["agent2"], "SHELL": shell})
    if "@" in re.sub(r"#.*", "", body) and re.search(r"@[A-Z_0-9]+@|@Q:[A-Z_0-9]+@", re.sub(r"#.*", "", body)):
        print("kittymux sessions: the template has a placeholder this command does not know", file=sys.stderr)
        return 2
    sdir = _sessions_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    path = os.path.join(sdir, pos[0] + ".kitty-session")
    if os.path.exists(path) and "--force" not in argv:
        print(f"kittymux sessions: {path} exists (--force to replace it)", file=sys.stderr)
        return 1
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(body)
    print(f"{OK} {path}\n    open it with: kittymux sessions restore {pos[0]}")
    return 0


# ── the restore prompt ───────────────────────────────────────────────────────
RESUME_ALL_S = 120          # "resume all" answers every other waiting prompt for this long


def _resume_all_file() -> str:
    return os.path.join(kittymux_layout.state_dir(), "resume-all-until")


def _resume_all_active(now: float | None = None) -> bool:
    try:
        with open(_resume_all_file(), encoding="utf-8") as f:
            return float(f.read().strip() or 0) > (now if now is not None else time.time())
    except (OSError, ValueError):
        return False


def _auto_resume() -> bool:
    """Resume without asking: KITTYMUX_RESUME=auto, a `resume-auto` flag file in the state dir, or a recent `a` (resume all) answer."""
    return (os.environ.get("KITTYMUX_RESUME", "").lower() == "auto" or os.path.exists(os.path.join(kittymux_layout.state_dir(), "resume-auto"))
            or _resume_all_active())


def resume_summary(info: dict, records: dict | None = None, now: float | None = None) -> list[str]:
    """The lines the prompt shows: what it would resume and what we know about that conversation (from the journal)."""
    now = now if now is not None else time.time()
    records = records if records is not None else kittymux_journal.load(kittymux_layout.state_dir())
    rec = records.get(f"{info['agent']}:{info['sid']}") if info["sid"] else None
    cwd = os.getcwd().replace(os.path.expanduser("~"), "~")
    sid = info["sid"]
    what = (f"session {sid if len(sid) <= 24 and not kittymux_resume._UUID.fullmatch(sid) else sid[:8]}" if sid else "the latest session in this directory")
    lines = [f"{info['agent']} was running here — resume {what}?", f"  {cwd}"]
    if rec:
        bits = [f"last active {kittymux_journal.human_span(now - rec.get('last', now))} ago"]
        if rec.get("turns"):
            bits.append(f"{rec['turns']} run{'s' if rec['turns'] != 1 else ''} finished")
        if rec.get("work_s"):
            bits.append(f"{kittymux_journal.human_span(rec['work_s'])} of work")
        if rec.get("tab"):
            bits.append(f"tab “{rec['tab'][:30]}”")
        lines.append("  " + " · ".join(bits))
    return lines


def resume_prompt(argv: list[str]) -> int:
    """`kittymux resume-prompt --info JSON` — what a restored agent window runs instead of the agent. Asks once, then REPLACES itself with the answer
    (exec), so the agent is the window's foreground process exactly as if it had been started directly. Enter/r resume · n new conversation · s shell ·
    a resume this and every other waiting prompt · i show the commands."""
    info = None
    if len(argv) == 2 and argv[0] == "--info":
        info = kittymux_resume.parse_info(argv[1])
    shell = [os.environ.get("SHELL") or "/bin/sh"]
    if info is None:
        print("kittymux: this restored window has a resume record I do not understand — opening a shell instead.", file=sys.stderr)
        os.execvp(shell[0], shell)
    choice = "resume" if _auto_resume() else None
    tty = None
    if choice is None:
        try:
            tty = os.open("/dev/tty", os.O_RDWR)
        except OSError:
            choice = "new"                      # nobody to ask: the original command is the harmless one
    if choice is None:
        choice = _ask_on_tty(tty, info)
        os.close(tty)
    if choice == "all":
        try:
            os.makedirs(kittymux_layout.state_dir(), mode=0o700, exist_ok=True)
            with open(_resume_all_file(), "w", encoding="utf-8") as f:
                f.write(str(time.time() + RESUME_ALL_S))
        except OSError:
            pass
        choice = "resume"
    target = {"resume": info["resume"], "new": info["orig"], "shell": shell}[choice]
    if shutil.which(target[0]) is None:
        print(f"kittymux: {target[0]} is not on PATH — opening a shell instead.", file=sys.stderr)
        target = shell
    os.execvp(target[0], target)
    return 1


def _ask_on_tty(fd: int, info: dict) -> str:
    import select
    import termios
    import tty as ttymod
    old = termios.tcgetattr(fd)
    out = lambda text: os.write(fd, text.encode())
    # An unnamed tab would otherwise be called "python" (this very process) while it waits. The title is cleared again before the agent takes over:
    # kitty keeps the last title a program set, and an agent that never sets one must not wear "resume?" for the rest of its life.
    out(f"\x1b]2;↻ {kittymux_place.clean(str(info['agent']))} — resume?\x07")
    for line in resume_summary(info):
        out(c("1", line) + "\r\n" if line.startswith(info["agent"]) else c("2", line) + "\r\n")
    out("  " + c("1", "Enter") + " resume   " + c("1", "n") + " new conversation   " + c("1", "s") + " shell   " + c("1", "a") + " resume all   " + c("1", "i") + " commands\r\n")
    choice = None
    try:
        ttymod.setcbreak(fd)
        while choice is None:
            ready, _, _ = select.select([fd], [], [], 0.5)
            if not ready:
                if _resume_all_active():                # another window's prompt was answered with "a"
                    choice = "resume"
                continue
            data = os.read(fd, 32)
            if not data:
                choice = "new"
                break
            if ready and data == b"\x1b":                # a lone ESC; a sequence arrives in one read together
                more, _, _ = select.select([fd], [], [], 0.05)
                if more:
                    data += os.read(fd, 32)
            action = kittymux_resume.prompt_choice(data)
            if action == "info":
                out("  new:     " + shlex.join(info["orig"]) + "\r\n  resume:  " + shlex.join(info["resume"]) + "\r\n")
            elif action:
                choice = action
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out("\x1b]2;\x07")                          # an empty title: back to the process's own
    return choice


# ── journal: history and recovery ────────────────────────────────────────────
def sessions_history(argv: list[str]) -> int:
    span = kittymux_journal.parse_span(next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a == "--since"), "7d"), 7 * 86400)
    now = time.time()
    recs = kittymux_journal.entries(kittymux_journal.load(kittymux_layout.state_dir()), now, span)
    ins = kittymux_journal.insights(recs)
    if "--json" in argv:
        safe = [dict(e, argv=kittymux_journal.redact_argv(e["argv"])) if isinstance(e.get("argv"), list) else e for e in recs]     # output that may be pasted: no secrets
        print(json.dumps({"insights": ins, "sessions": safe}, indent=1, sort_keys=True))
        return 0
    if not recs:
        print("no agent sessions recorded in that time (the scanner records them while a kitty runs)")
        return 0
    print(c("1", f"{ins['sessions']} agent sessions · {ins['running']} running now · {ins['turns']} runs finished · "
                 f"{kittymux_journal.human_span(ins['work_s'])} of agent work"))
    print(c("2", "  " + "   ".join(f"{a} {v['sessions']}×/{kittymux_journal.human_span(v['work_s'])}" for a, v in sorted(ins["by_agent"].items()))))
    for e in recs:
        sid = (e.get("sid") or "")[:8] or "—"
        print("  %-13s %-9s %-26s %6s ago  %3s runs %7s  %s" % (
            e["agent"], sid, (e.get("cwd") or "").replace(os.path.expanduser("~"), "~")[-26:], kittymux_journal.human_span(now - e.get("last", now)),
            e.get("turns", 0), kittymux_journal.human_span(e.get("work_s", 0)), c("32", "running") if e["running"] else c("2", "closed")))
    return 0


def sessions_recover(argv: list[str]) -> int:
    """A session file with one tab per agent conversation that was active recently and is not running now (a crash, a closed kitty). Each comes back
    through the resume prompt. `kittymux sessions restore recovered` opens it."""
    span = kittymux_journal.parse_span(next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a == "--since"), "6h"), 6 * 3600)
    name = next((a for a in argv if not a.startswith("-") and not re.fullmatch(r"\d+[smhd]", a)), "recovered")
    if not TEMPLATE_NAME.match(name):
        print("kittymux sessions: a session name is letters, digits, . _ - (up to 60)", file=sys.stderr)
        return 2
    agents = _resume_agents()
    now = time.time()
    todo = kittymux_journal.recoverable(kittymux_journal.entries(kittymux_journal.load(kittymux_layout.state_dir()), now, span))
    lines, shown = [f"# kittymux: recovered agent sessions, {time.strftime('%Y-%m-%d %H:%M')}", ""], []
    for e in todo:
        if not os.path.isdir(e.get("cwd", "")) or not isinstance(e.get("argv"), list):
            continue
        hit = kittymux_resume.agent_of(agents, e["argv"])
        mode = "exact" if e.get("sid") else "latest"
        new = hit and kittymux_resume.resume_argv(agents[hit[0]], e["argv"], e.get("sid") or None, mode, hit[1])
        if not new:
            continue
        launch = prompt_wrapper() + ["--info", kittymux_resume.prompt_info(hit[0], mode, e.get("sid"), e["argv"], new)]
        title = re.sub(r"[\r\n]+", " ", e.get("tab") or e["agent"])[:40]
        lines += [f"new_tab {title}", f"cd {shlex.quote(e['cwd'])}", "launch --title " + shlex.quote(e["agent"]) + " " + shlex.join(launch), ""]
        shown.append(e)
    if not shown:
        print("nothing to recover: no agent session that was active recently and is not running now")
        return 0
    sdir = _sessions_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    path = os.path.join(sdir, name + ".kitty-session")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\nfocus_tab 0\n")
    print(f"{OK} {path}")
    for e in shown:
        print(f"    {e['agent']:<13} {(e.get('cwd') or '').replace(os.path.expanduser('~'), '~')}  (last active {kittymux_journal.human_span(now - e.get('last', now))} ago)")
    print(f"  open it with: kittymux sessions restore {name}")
    return 0


def sessions(argv: list[str]) -> int:
    cmd = argv[0] if argv and not argv[0].startswith("-") else "list"
    rest = argv[1:] if argv and not argv[0].startswith("-") else argv
    table = {"list": sessions_list, "save": sessions_save, "restore": sessions_restore, "new": sessions_new, "check": sessions_check,
             "rewrite": sessions_rewrite, "history": sessions_history, "recover": sessions_recover}
    if cmd == "templates":
        for name, path in sorted(list_templates().items()):
            first = open(path, encoding="utf-8").readline().strip("# \n")
            print(f"  {name:<8} {first}")
        return 0
    if cmd == "autosave":
        return sessions_autosave()
    if cmd == "prepare":
        sock = _target_socket()
        if not sock:
            return 1
        sessions_prepare(sock)
        return 0
    if cmd not in table:
        print("usage: kittymux sessions [list|save|restore|new|templates|check|prepare|rewrite|history|recover]", file=sys.stderr)
        return 2
    return table[cmd](rest)


# ── launcher: spawn agents, jump to anything, reopen what was closed ─────────
def _risk_table() -> dict:
    user = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kittymux", "risk.json")
    return kittymux_launcher.load_risk(os.path.join(HOME_DIR, "assets", "agent-risk.json"), user)


def _headroom_hints(installed: list) -> dict:
    """{agent: '5h 99% used'} from the usage cache the panel and the overlay keep (never a network call; a cache older than 12 h says nothing)."""
    try:
        path = os.path.join(kittymux_layout.state_dir(), "agent-usage.json")
        if os.stat(path).st_size > 2 * 1024 * 1024:
            return {}
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict) or time.time() - float(data.get("ts") or 0) > 12 * 3600:
            return {}
        return kittymux_meters.hints_for(data.get("providers"), installed)
    except (OSError, ValueError, TypeError):
        return {}


_LS_MEMO: dict = {}


def _ls(sock: str) -> list | None:
    """`kitty @ ls` of one socket (~22 ms), remembered for 2 s: one picker run asks the same question for focus, rows and the working directory."""
    hit = _LS_MEMO.get(sock)
    if hit and time.monotonic() - hit[0] < 2.0:
        return hit[1]
    rc, out = _run(["kitty", "@", "--to", sock, "ls"], 6)
    data = None
    if rc == 0:
        try:
            parsed = json.loads(out)
            data = parsed if isinstance(parsed, list) else None
        except ValueError:
            data = None
    _LS_MEMO[sock] = (time.monotonic(), data)
    return data


def _focused_socket() -> str | None:
    """Which kitty a launcher acts on. An explicit KITTYMUX_TARGET, else the kitty this command was started FROM (a key inside kitty must act on that kitty, never on whichever one
    happens to have focus — a second kitty, a scratch instance or a test rig must not be hijacked), else — started from outside every kitty, e.g. a window-manager bind — the one
    that has the keyboard focus right now, else the newest."""
    explicit = os.environ.get("KITTYMUX_TARGET", "")
    if explicit.startswith("unix:") and _owned_socket(explicit[5:]):
        return explicit
    own = _own_kitty_socket()
    if own:
        return own
    for sock in _sockets():
        data = _ls(sock)
        if data and any(o.get("is_focused") for o in data):
            return sock
    return _target_socket()


def _focus_wm(pid) -> None:
    if shutil.which("hyprctl") and str(pid).isdigit():
        _run(["hyprctl", "dispatch", "focuswindow", f"pid:{pid}"], 3)


def _installed_agents() -> list[str]:
    return [a for a in kittymux_launcher.SPAWN_ORDER if shutil.which(a)]


def _launch(sock: str, args: list[str]) -> bool:
    rc, _ = _run(["kitty", "@", "--to", sock, "launch", *args], 8)
    return rc == 0


def _launch_tab_before_scratch(sock: str, make) -> bool:
    """`make(before_scratch)` → launch args. A tab goes before the `!scratch` tab when there is one (so scratch stays last), else plain."""
    return _launch(sock, make(True)) or _launch(sock, make(False))


def spawn(argv: list[str]) -> int:
    """`kittymux spawn AGENT[,AGENT…] [--tab|--hsplit|--vsplit] [--cwd DIR]` — start agents straight into a new tab or split of the focused kitty, in the current directory."""
    where, cwd, names, wm = "tab", None, [], False
    it = iter(argv)
    for a in it:
        if a in ("--tab", "--hsplit", "--vsplit"):
            where = a[2:]
        elif a == "--cwd":
            cwd = os.path.abspath(os.path.expanduser(next(it, "")))
        elif a == "--focus-wm":
            wm = True
        elif a.startswith("-"):
            print("usage: kittymux spawn AGENT[,AGENT…] [--tab|--hsplit|--vsplit] [--cwd DIR]", file=sys.stderr)
            return 2
        else:
            names += [n for n in a.split(",") if n]
    if not names:
        print("usage: kittymux spawn AGENT[,AGENT…] [--tab|--hsplit|--vsplit] [--cwd DIR]   (agents: " + ", ".join(kittymux_launcher.SPAWN_ORDER) + ")", file=sys.stderr)
        return 2
    if cwd is not None and not os.path.isdir(cwd):
        print(f"kittymux spawn: {cwd} is not a directory", file=sys.stderr)
        return 2
    sock = _focused_socket()
    if not sock:
        print("kittymux spawn: no kitty remote-control socket found (allow_remote_control socket-only + listen_on unix:${XDG_RUNTIME_DIR}/mykitty)", file=sys.stderr)
        return 1
    source = os.environ.get("KITTY_WINDOW_ID") if os.environ.get("KITTY_WINDOW_ID", "").isdigit() else None
    failed = 0
    for name in names:
        agent = kittymux_launcher.resolve_agent(name)
        exe = shutil.which(agent) if agent else None
        if not agent or not exe:
            msg = f"{name}: " + ("not a known agent" if not agent else "not installed (not on PATH)")
            print(f"{BAD} kittymux spawn: {msg}", file=sys.stderr)
            _notify(msg)
            failed += 1
            continue
        make = lambda scratch, agent=agent, exe=exe: kittymux_launcher.launch_args(agent, exe, where, cwd, source, scratch and where == "tab")      # noqa: E731
        ok = _launch_tab_before_scratch(sock, make) if where == "tab" else _launch(sock, make(False))
        if ok:
            print(f"{OK} {agent} → new {'tab' if where == 'tab' else 'split'}")
        else:
            print(f"{BAD} kittymux spawn: kitty did not start {agent}", file=sys.stderr)
            failed += 1
    if wm and not failed and _socket_pid(sock):
        _focus_wm(_socket_pid(sock))
    return 1 if failed else 0


def _settle_after() -> float:
    """Days before an untouched closed conversation counts as settled: $KITTYMUX_SETTLE_DAYS (1–365), default 3."""
    try:
        days = float(os.environ.get("KITTYMUX_SETTLE_DAYS", ""))
        if 1 <= days <= 365:
            return days * 86400
    except ValueError:
        pass
    return kittymux_journal.SETTLE_AFTER_S


def _reopenable(now: float, since: float = kittymux_journal.MAX_AGE_S) -> list[dict]:
    """Journal entries that were agent sessions, are not running and can be restarted (a command and an existing directory), newest first — each with its `lifecycle`
    (pinned | recent | settled). A pinned one is never aged out, so `since` defaults to the journal's own limit."""
    after = _settle_after()
    out = []
    for e in kittymux_journal.recoverable(kittymux_journal.entries(kittymux_journal.load(kittymux_layout.state_dir()), now, since)):
        if os.path.isdir(e.get("cwd", "")):
            e["lifecycle"] = kittymux_journal.lifecycle(e, now, after)
            out.append(e)
    return out


def reopen_entry(e: dict, sock: str) -> bool:
    agents = _resume_agents()
    hit = kittymux_resume.agent_of(agents, e["argv"])
    mode = "exact" if e.get("sid") else "latest"
    new = hit and kittymux_resume.resume_argv(agents[hit[0]], e["argv"], e.get("sid") or None, mode, hit[1])
    if not new:
        print(f"{BAD} kittymux reopen: no safe way to reopen {e.get('agent')} (see `kittymux sessions check`)", file=sys.stderr)
        return False
    wrapper = prompt_wrapper() + ["--info", kittymux_resume.prompt_info(hit[0], mode, e.get("sid"), e["argv"], new)]
    title = kittymux_launcher.clean_text(e.get("tab") or e["agent"], 40) or e["agent"]
    def make(scratch):
        a = ["--type=tab"] + (["--match", "title:^!scratch and state:focused_os_window", "--location=before"] if scratch else [])
        return a + [f"--cwd={e['cwd']}", "--tab-title", title, "--title", e["agent"], f"--var=kittymux_agent={e['agent']}", "--", *wrapper]
    return _launch_tab_before_scratch(sock, make)


def reopen(argv: list[str]) -> int:
    """`kittymux reopen [KEY]` — bring back the most recently closed agent conversation in a new tab (it asks before resuming, like any restore)."""
    now = time.time()
    keys = [a for a in argv if not a.startswith("-")]
    rows = _reopenable(now)
    target = next((e for e in rows if e["key"] == keys[0]), None) if keys else (rows[0] if rows else None)
    if target is None:
        print("kittymux reopen: no closed agent session to bring back" + (f" matching {keys[0]}" if keys else ""), file=sys.stderr)
        return 1
    sock = _focused_socket()
    if not sock:
        print("kittymux reopen: no kitty remote-control socket found", file=sys.stderr)
        return 1
    if not reopen_entry(target, sock):
        return 1
    print(f"{OK} reopened {target['agent']} in {target['cwd'].replace(os.path.expanduser('~'), '~')}")
    return 0


def _focus_cwd(sock: str | None) -> str:
    """Working directory of the focused window of that kitty (what `--cwd=current` will use), else ''."""
    for osw in (_ls(sock) or []) if sock else []:
        if osw.get("is_focused"):
            for tab in osw.get("tabs", []):
                if tab.get("is_active"):
                    for w in tab.get("windows", []):
                        if w.get("is_active") or w.get("is_focused"):
                            return w.get("cwd", "")
    return ""


def _pick_data(now: float) -> tuple[list, list, list, list]:
    """(unread events, live agent windows across every kitty, closed conversations, installed agents)."""
    sdir = kittymux_layout.state_dir()
    events = [e for e in kittymux_inbox.load(sdir) if e.get("status") == "unread"]
    records = kittymux_journal.load(sdir)
    windows = []
    for sock in _sockets():
        pid = _socket_pid(sock)
        data = _ls(sock) or []
        changed = kittymux_changes.load(sdir, pid)
        try:
            with open(os.path.join(sdir, f"scan-{pid}.json"), encoding="utf-8") as f:
                verdicts = json.load(f)
        except (OSError, ValueError):
            verdicts = {}
        for osw in data:
            for tab in osw.get("tabs", []):
                for w in tab.get("windows", []):
                    v = verdicts.get(str(w.get("id"))) or {}
                    if not v.get("agent"):
                        continue
                    fg = [p.get("cmdline") or [] for p in w.get("foreground_processes", [])]
                    argv = next((c for c in fg if kittymux_agents.agent_in(c) == v["agent"]), fg[0] if fg else [])
                    jkey = kittymux_journal.key_for_window(records, pid, w["id"])
                    delta = kittymux_changes.format_summary(((changed.get(str(w["id"])) or {}).get("summary")))
                    windows.append({"pid": pid, "w": w["id"], "agent": v["agent"], "state": v.get("state", ""), "tab": tab.get("title", ""), "cwd": w.get("cwd", ""), "argv": argv,
                                    "jkey": jkey, "pinned": bool(jkey and records[jkey].get("pinned")), "changes": delta})
    return events, windows, _reopenable(now), _installed_agents()


def _choose_menu(pref: str) -> str | None:
    have = [m for m in ("rofi", "fuzzel", "fzf") if shutil.which(m)]
    if pref and pref != "auto":
        return pref if pref in have else None
    tty = sys.stdin.isatty() and sys.stdout.isatty()
    order = ["fzf", "rofi", "fuzzel"] if tty else ["rofi", "fuzzel"]
    return next((m for m in order if m in have), None)


def _toggle_flag(row: dict, field: str) -> int:
    """pin / settle the conversation a picker row stands for (a toggle: pinning a pinned one unpins it)."""
    key = row.get("jkey")
    if not key:
        print(f"kittymux pick: nothing to {field} on this row" + (" (only agent windows and conversations can be)" if field != "ack" else ""), file=sys.stderr)
        return 1
    if field == "pinned" and not (row.get("pinned")) and not kittymux_journal.set_flag(kittymux_layout.state_dir(), key, "pinned", True):
        return 1
    if field == "pinned" and row.get("pinned") and not kittymux_journal.set_flag(kittymux_layout.state_dir(), key, "pinned", False):
        return 1
    if field == "settled":
        if row["kind"] != "closed":
            print("kittymux pick: only a closed conversation can be settled (a running one is live)", file=sys.stderr)
            return 1
        if not kittymux_journal.set_flag(kittymux_layout.state_dir(), key, "settled", not row.get("settled")):
            return 1
    return 0


def _do_row(row: dict, how: str, sock: str | None) -> int:
    a = row["action"]
    sdir = kittymux_layout.state_dir()
    if how == "ack":
        if row.get("event"):
            kittymux_inbox.ack(sdir, time.time(), ids=[row["event"]])
            print(f"{OK} marked read")
            return 0
        print("kittymux pick: only attention events can be marked read", file=sys.stderr)
        return 1
    if how == "pin":
        return _toggle_flag(row, "pinned")
    if how == "settle":
        return _toggle_flag(row, "settled")
    if a["op"] == "jump":
        return inbox_jump({"pid": a.get("pid"), "w": a.get("w")})            # also marks that window's events read
    if a["op"] == "reopen":
        target = next((e for e in _reopenable(time.time()) if e["key"] == a.get("key")), None)
        sock = sock or _focused_socket()
        if target is None or not sock or not reopen_entry(target, sock):
            return 1
        _focus_wm(_socket_pid(sock))
        return 0
    if a["op"] == "usage":
        return usage_cmd(["--window"])
    if a["op"] == "spawn":
        return spawn([a["agent"], f"--{a['where']}", "--focus-wm"])
    return 1


def _write_rofi_theme(sock: str | None) -> str | None:
    """Our rofi theme for the live kitty colours, written 0600 into the state dir; None (→ the user's own rofi theme) when the colours cannot be read."""
    if not sock:
        return None
    rc, out = _run(["kitty", "@", "--to", sock, "get-colors"], 4)
    if rc != 0:
        return None
    p = kittymux_theme.from_colors(kittymux_theme.parse_kitty_colors(out))
    hexc = lambda v: f"#{v:06x}"                                    # noqa: E731
    colors = {k: hexc(getattr(p, k)) for k in ("bg", "bar", "surface", "surface_hi", "text", "muted", "faint", "accent", "waiting", "working", "alert")}
    text = kittymux_launcher.rofi_theme(colors, os.path.join(HOME_DIR, "assets", "notify", "kittymux.png"))
    if not text:
        return None
    path = os.path.join(kittymux_layout.state_dir(), "rofi-kittymux.rasi")
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError:
        return None
    return path


def pick(argv: list[str]) -> int:
    """`kittymux pick [--menu rofi|fuzzel|fzf|auto] [--list|--json]` — one searchable list of everything that wants you, every running agent, every conversation you closed,
    and a new agent: type to filter, Enter goes there. Bind it in your window manager (`kittymux pick --menu rofi`) to reach any agent from anywhere."""
    menu_pref = next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a == "--menu"), "auto")
    focused = _focused_socket()                  # decided BEFORE the menu opens: a menu takes the keyboard focus away from kitty
    if focused:
        os.environ["KITTYMUX_TARGET"] = focused
    include_settled = "--all" in argv
    theme, notify_dir, mascot = None, None, None
    menu = None
    for _round in range(12):                     # ack / pin / settle / "show settled" refresh the list and ask again; anything else leaves
        now = time.time()
        events, windows, closed, installed = _pick_data(now)
        rows = kittymux_launcher.build_rows(events, windows, closed, installed, now, home=os.path.expanduser("~"), cwd=_focus_cwd(focused), risk=_risk_table(),
                                            include_settled=include_settled, headroom=_headroom_hints(installed))
        rows.append({"kind": "utility", "agent": "", "tone": "", "action": {"op": "usage"},
                     "text": "≋  Usage   provider quotas · resets · local activity"})
        if "--json" in argv:
            print(json.dumps(rows, indent=1))
            return 0
        if "--list" in argv:
            for r in rows:
                print(r["text"])
            return 0
        if not rows:
            print("kittymux pick: nothing to show (no agents installed, running or closed)", file=sys.stderr)
            return 1
        if menu is None:
            menu = _choose_menu(menu_pref)
            if menu is None:
                print("kittymux pick: no menu program (install rofi or fuzzel for a window-manager launcher, or run it inside kitty with fzf)", file=sys.stderr)
                return 1
            if menu == "rofi" and "--no-theme" not in argv and os.environ.get("KITTYMUX_ROFI_THEME") != "user":
                theme = _write_rofi_theme(focused)
                if theme:
                    notify_dir, mascot = os.path.join(HOME_DIR, "assets", "notify"), os.path.join(HOME_DIR, "assets", "notify", "kittymux.png")
        n_need = sum(1 for r in rows if r["kind"] == "event")
        msg = f"{n_need} need you · alt+a read · alt+p pin · alt+s settle" if menu == "rofi" else ""
        cmd, stdin = kittymux_launcher.menu_command(menu, rows, msg, theme, notify_dir, mascot)
        try:
            r = subprocess.run(cmd, input=stdin, stdout=subprocess.PIPE, text=True, timeout=600)
        except (OSError, subprocess.SubprocessError):
            print(f"kittymux pick: could not run {menu}", file=sys.stderr)
            return 1
        choice = kittymux_launcher.parse_choice(menu, rows, r.returncode, r.stdout)
        if choice is None:
            return 0                                              # cancelled
        row, how = choice
        if how == "open" and row["action"]["op"] == "all":
            include_settled = True
            continue
        rc = _do_row(row, how, focused)
        if how == "open" or rc != 0:
            return rc
    return 0


def _resolve_journal_key(args: list[str], verb: str) -> str | None:
    """The journal record a `pin`-style verb means: an explicit KEY, `--window ID`, or (inside a window) this window's agent session."""
    unknown = [a for a in args if a.startswith("-") and a != "--window"]
    if unknown:
        print(f"kittymux {verb}: unknown option {unknown[0]}   usage: kittymux {verb} [KEY | --window ID]", file=sys.stderr)
        return None
    keys = [a for i, a in enumerate(args) if not a.startswith("-") and not (i and args[i - 1] == "--window")]
    records = kittymux_journal.load(kittymux_layout.state_dir())
    if keys:
        match = [k for k in records if k == keys[0] or k.startswith(keys[0])]
        if len(match) == 1:
            return match[0]
        print(f"kittymux {verb}: " + ("no conversation matches " if not match else "several conversations match ") + f"'{keys[0]}' (see `kittymux sessions history`)", file=sys.stderr)
        return None
    wid = next((args[i + 1] for i, a in enumerate(args[:-1]) if a == "--window"), os.environ.get("KITTY_WINDOW_ID", ""))
    sock = _target_socket()
    pid = _socket_pid(sock) if sock else None
    key = kittymux_journal.key_for_window(records, pid, wid) if str(wid).isdigit() and pid else None
    if key is None:
        print(f"kittymux {verb}: run it inside an agent window, or give --window ID or a conversation KEY (`kittymux sessions history` lists them)", file=sys.stderr)
    return key


def lifecycle_verb(verb: str, args: list[str]) -> int:
    """`kittymux pin|unpin|settle|unsettle [KEY | --window ID]` — keep a conversation at the top of `pick` and out of the age limits (pin), or fold it away / bring it back (settle)."""
    key = _resolve_journal_key(args, verb)
    if key is None:
        return 1
    field, value = {"pin": ("pinned", True), "unpin": ("pinned", False), "settle": ("settled", True), "unsettle": ("settled", False)}[verb]
    if not kittymux_journal.set_flag(kittymux_layout.state_dir(), key, field, value):
        print(f"kittymux {verb}: could not update {key}", file=sys.stderr)
        return 1
    print(f"{OK} {verb}: {key}")
    return 0


# ── fan-out: one task, several agents, each in its own worktree ──────────────
def _prompt_forms() -> dict:
    user = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "kittymux", "prompt.json")
    return kittymux_launcher.load_prompt_forms(os.path.join(HOME_DIR, "assets", "agent-prompt.json"), user)


def fanout(argv: list[str]) -> int:
    """`kittymux fanout "PROMPT" claude,codex,devin [--name N] [--base REF] [--cwd DIR]` — the same task to several agents at once, each in its OWN git worktree and branch
    (`<repo>/.worktrees/<name>-<agent>`, from one base commit), one tab each, so they cannot step on each other. Then `fanout compare NAME` to see what each did.
    Also: `fanout list` · `fanout compare NAME` · `fanout clean NAME [--yes] [--force]`."""
    usage = "usage: kittymux fanout \"PROMPT\" AGENT[,AGENT…] [--name N] [--base REF] [--cwd DIR]   |   fanout list | compare NAME | clean NAME [--yes] [--force]"
    opts, pos, it = {}, [], iter(argv)
    for a in it:
        if a in ("--name", "--base", "--cwd"):
            opts[a[2:]] = next(it, "")
        elif a in ("--yes", "--force"):
            opts[a[2:]] = True
        elif a.startswith("-") and a != "-":
            print(f"kittymux fanout: unknown option {a}\n{usage}", file=sys.stderr)
            return 2
        else:
            pos.append(a)
    sdir = kittymux_layout.state_dir()
    records = kittymux_fanout.load(sdir)
    if pos[:1] == ["list"] and len(pos) == 1:
        for name, r in sorted(records.items(), key=lambda kv: -kv[1].get("created", 0)):
            print(f"  {name:<28} {', '.join(i['agent'] for i in r['agents']):<34} {time.strftime('%Y-%m-%d %H:%M', time.localtime(r.get('created', 0)))}  {kittymux_launcher.clean_text(r.get('prompt', ''), 50)}")
        if not records:
            print("no fan-outs yet")
        return 0
    if pos[:1] in (["compare"], ["clean"]) and len(pos) == 2 and pos[1] in records:
        rec = records[pos[1]]
        if pos[0] == "compare":
            rows = kittymux_fanout.compare(sdir, rec)
            print(c("1", f"{pos[1]}") + c("2", f"   base {rec['base'][:8]}   {kittymux_launcher.clean_text(rec.get('prompt', ''), 60)}"))
            for r in rows:
                text = "worktree gone" if not r["exists"] else kittymux_changes.format_summary(r["summary"]) if r["summary"] else "unreadable"
                print(f"  {r['agent']:<14} {text:<22} {c('2', r['branch'])}")
            return 0
        if not opts.get("yes"):
            print(c("2", "dry run — nothing is removed (add --yes)"))
            for it_ in rec["agents"]:
                print(f"  would remove worktree {it_['path']} and branch {it_['branch']}" + ("" if opts.get("force") else "   (kept if it has uncommitted changes)"))
            return 0
        notes = kittymux_fanout.remove(rec["repo"], rec["agents"], force=bool(opts.get("force")))
        for n in notes:
            print(f"  {n}")
        if not any(n.startswith("kept") for n in notes):
            kittymux_fanout.forget(sdir, pos[1])
        return 0
    if len(pos) != 2:
        print(usage, file=sys.stderr)
        return 2
    prompt, agent_arg = pos
    forms = _prompt_forms()
    agents, seen = [], set()
    for n in agent_arg.split(","):
        a = kittymux_launcher.resolve_agent(n)
        if not a:
            print(f"{BAD} kittymux fanout: '{n}' is not a known agent ({', '.join(kittymux_launcher.SPAWN_ORDER)})", file=sys.stderr)
            return 2
        if a not in seen:
            seen.add(a)
            agents.append(a)
    for a in agents:
        if not shutil.which(a):
            print(f"{BAD} kittymux fanout: {a} is not installed (not on PATH)", file=sys.stderr)
            return 1
        if a not in forms:
            print(f"{BAD} kittymux fanout: no verified way to give {a} a first prompt (add it to ~/.config/kittymux/prompt.json)", file=sys.stderr)
            return 1
    if kittymux_launcher.validate_prompt(prompt) is None:
        print(f"{BAD} kittymux fanout: the prompt must be 1–{kittymux_launcher.PROMPT_MAX} characters and not start with '-'", file=sys.stderr)
        return 2
    prompt = kittymux_launcher.validate_prompt(prompt)
    cwd = os.path.abspath(os.path.expanduser(opts.get("cwd") or os.getcwd()))
    repo = kittymux_fanout.main_repo(cwd)
    if repo is None:
        print(f"{BAD} kittymux fanout: {cwd} is not inside a git repository (parallel agents need a worktree each)", file=sys.stderr)
        return 1
    name = opts.get("name") or time.strftime("fanout-%m%d-%H%M")
    if not kittymux_fanout.NAME_RE.match(name):
        print(f"{BAD} kittymux fanout: --name is letters, digits, . _ - (up to 41)", file=sys.stderr)
        return 2
    base = kittymux_fanout.resolve_base(repo, opts.get("base"))
    if base is None:
        print(f"{BAD} kittymux fanout: --base {kittymux_launcher.clean_text(opts.get('base') or 'HEAD', 60)} is not a commit in {repo}", file=sys.stderr)
        return 1
    sock = _focused_socket()
    if not sock:
        print(f"{BAD} kittymux fanout: no kitty remote-control socket found", file=sys.stderr)
        return 1
    items, err = kittymux_fanout.create(repo, name, base, agents)
    if err:
        print(f"{BAD} kittymux fanout: {err}", file=sys.stderr)
        return 1
    kittymux_fanout.save(sdir, name, repo, base, prompt, items)
    failed = 0
    for it_ in items:
        exe = shutil.which(it_["agent"])
        extra = kittymux_launcher.prompt_args(forms, it_["agent"], prompt)
        make = lambda scratch, it_=it_, exe=exe, extra=extra: kittymux_launcher.launch_args(it_["agent"], exe, "tab", it_["path"], None, scratch, extra, f"{it_['agent']} · {name}")      # noqa: E731
        if _launch_tab_before_scratch(sock, make):
            print(f"{OK} {it_['agent']:<14} {c('2', it_['branch'])}")
        else:
            failed += 1
            print(f"{BAD} kitty did not start {it_['agent']} (its worktree is ready: {it_['path']})", file=sys.stderr)
    print(c("2", f"  base {base[:8]} · see what each did: kittymux fanout compare {name} · tidy up: kittymux fanout clean {name} --yes"))
    return 1 if failed else 0


# ── what did the agent change? ──────────────────────────────────────────────
def checkpoint(argv: list[str]) -> int:
    """`kittymux checkpoint start|finish --pid KITTY_PID --window ID --cwd DIR` — internal: the scanner runs it detached when an agent's run starts / ends (kittymux_changes)."""
    kind = argv[0] if argv else ""
    opt = lambda name: next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a == name), "")       # noqa: E731
    pid, wid, cwd = opt("--pid"), opt("--window"), opt("--cwd")
    if kind not in ("start", "finish") or not pid.isdigit() or not wid.isdigit() or not os.path.isdir(cwd):
        print("usage: kittymux checkpoint start|finish --pid KITTY_PID --window ID --cwd DIR", file=sys.stderr)
        return 2
    sdir = kittymux_layout.state_dir()
    ok = kittymux_changes.start(sdir, int(pid), int(wid), cwd) if kind == "start" else kittymux_changes.finish(sdir, int(pid), int(wid), cwd) is not None
    if kind == "start":
        kittymux_changes.prune_stores(sdir)
    return 0 if ok else 1


def changes_cmd(argv: list[str]) -> int:
    """`kittymux changes [--window ID] [--files] [--json] [--all]` — what the agent in a window changed since its run started (or since HEAD when kittymux was not watching
    at the start): `7 files +142 −30` and the biggest files. Computed now, so it is right even mid-run. `--all`: the cached summary of every window in this kitty (no git)."""
    unknown = [a for a in argv if a.startswith("-") and a not in ("--files", "--json", "--all", "--window")]
    if unknown:
        print(f"kittymux changes: unknown option {unknown[0]}   usage: kittymux changes [--window ID] [--files] [--json] [--all]", file=sys.stderr)
        return 2
    sock = _target_socket()
    pid = _socket_pid(sock) if sock else None
    if pid is None:
        print("kittymux changes: no kitty remote-control socket found", file=sys.stderr)
        return 1
    sdir = kittymux_layout.state_dir()
    wins = {str(w["id"]): (w, t.get("title", "")) for o in (_ls(sock) or []) for t in o.get("tabs", []) for w in t.get("windows", [])}
    if "--all" in argv:
        cache = kittymux_changes.load(sdir, pid)
        shown = 0
        for wid, (w, title) in wins.items():
            text = kittymux_changes.format_summary((cache.get(wid) or {}).get("summary"))
            if text:
                shown += 1
                print(f"  window {wid:<4} {kittymux_launcher.clean_text(title, 40):<40} {text}")
        if not shown:
            print("no agent run has finished in this kitty yet")
        return 0
    wid = next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a == "--window"), os.environ.get("KITTY_WINDOW_ID", ""))
    if not str(wid).isdigit() or wid not in wins:
        print("kittymux changes: run it inside an agent window, or give --window ID", file=sys.stderr)
        return 2
    cwd = wins[wid][0].get("cwd", "")
    summary = kittymux_changes.finish(sdir, pid, int(wid), cwd)
    if summary is None:
        print(f"kittymux changes: {kittymux_launcher.clean_text(cwd, 80) or 'this window'} is not a git repository (or git could not read it)", file=sys.stderr)
        return 1
    entry = kittymux_changes.load(sdir, pid).get(wid, {})
    since = f"since its run started {kittymux_journal.human_span(time.time() - entry['base_ts'])} ago" if entry.get("vs") == "run" and entry.get("base_ts") else "compared with HEAD (kittymux was not watching when the run started)"
    if "--json" in argv:
        print(json.dumps({"window": int(wid), "vs": entry.get("vs"), **summary}, indent=1))
        return 0
    print(f"{kittymux_changes.format_summary(summary)}   {c('2', since)}")
    if "--files" in argv or summary["files"] <= 12:
        for f in summary.get("files_list", [])[:40]:
            a, d = ("bin" if f["add"] is None else f"+{f['add']}"), ("" if f["del"] is None else f"−{f['del']}")
            print(f"  {a:>6} {d:>6}  {kittymux_launcher.clean_text(f['path'], 100)}")
    return 0


# ── notification management: mute, snooze ────────────────────────────────────
_DURATION = re.compile(r"^(\d+(?:\.\d+)?)([smhd])$")


def parse_duration(text: str) -> float | None:
    m = _DURATION.match((text or "").strip().lower())
    return float(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)] if m else None


def mute_remaining(now: float | None = None) -> float:
    until = kittymux_quiet.mute_until(kittymux_layout.state_dir(), now)
    return max(0.0, until - (now if now is not None else time.time())) if until else 0.0


def notify_cmd(argv: list[str]) -> int:
    """`kittymux notify status|mute [1h]|unmute|off|on|done off|done on` — quiet the popups and bells; everything still lands in the inbox, so nothing is lost."""
    sdir = kittymux_layout.state_dir()
    os.makedirs(sdir, mode=0o700, exist_ok=True)
    cmd = argv[0] if argv else "status"
    flag = lambda name: os.path.join(sdir, name)            # noqa: E731
    if cmd == "mute":
        span = parse_duration(argv[1] if len(argv) > 1 else "1h")
        if span is None or span <= 0 or span > kittymux_quiet.MAX_SPAN_S:
            print("usage: kittymux notify mute [30m|1h|2d]   (up to 30 days)", file=sys.stderr)
            return 2
        until = kittymux_quiet.set_mute(sdir, span)
        print(f"{OK} popups and bells muted until {time.strftime('%H:%M', time.localtime(until))} — everything is still collected in `kittymux inbox`")
        return 0
    if cmd == "unmute":
        kittymux_quiet.clear_mute(sdir)
        print(f"{OK} unmuted")
        return 0
    if cmd in ("off", "on"):
        (open(flag("notify-off"), "a").close() if cmd == "off" else (os.path.exists(flag("notify-off")) and os.unlink(flag("notify-off"))))
        print(f"{OK} notifications {cmd}")
        return 0
    if cmd == "done" and len(argv) > 1 and argv[1] in ("off", "on"):
        (open(flag("notify-done-off"), "a").close() if argv[1] == "off" else (os.path.exists(flag("notify-done-off")) and os.unlink(flag("notify-done-off"))))
        print(f"{OK} 'finished' notifications {argv[1]}")
        return 0
    if cmd == "status":
        left = mute_remaining()
        off = os.environ.get("KITTYMUX_NOTIFY") == "0" or os.path.exists(flag("notify-off"))
        print("notifications:", "OFF" if off else (f"muted for another {kittymux_journal.human_span(left)}" if left else "on"))
        print("'finished' popups:", "off" if os.environ.get("KITTYMUX_NOTIFY_DONE") == "0" or os.path.exists(flag("notify-done-off")) else "on")
        print("bells:", "off" if os.environ.get("KITTYMUX_BELL") == "0" or os.path.exists(flag("bell-off")) else "on (skipped where the compositor would steal focus)")
        unread = [e for e in kittymux_inbox.load(sdir) if e.get("status") == "unread"]
        print(f"inbox: {len(unread)} unread ({sum(1 for e in unread if e.get('severity') == 'needs-you')} need you)")
        return 0
    print("usage: kittymux notify status | mute [30m|1h|2d] | unmute | off | on | done off|on", file=sys.stderr)
    return 2


FEATURE_HELP = {
    "folder": "project[:worktree]/inner and branch under each tab (off: just the branch, as before)",
    "hue": "a stable colour per project (folder icon, active name, rail number)",
    "collide": "emphasise the project of tabs that show the same title",
    "sheet": "(planned — not built yet) the side sheet for a tab",
    "hover": "(planned — not built yet) open the sheet on hover, inside the sheet only: kitty sends the bar no idle motion",
    "panetitle": "the same line in each pane's title bar, plus the pane's own title (ctrl+alt+shift+c shows the bars; kitty ≥ 0.49.2)",
    "motion": "the working spinner turns (off: one still frame, and nothing redraws a bar just to animate it)",
}


def _nudge_bars() -> int:
    """Reload every running kitty once so a switch shows now (the bar reads the switches on each redraw).
    Returns how many kitties answered. The switches live in the shared state directory, so every kitty is the right audience."""
    done = 0
    for sock in _sockets():
        if _run(["kitty", "@", "--to", sock, "load-config"], 8)[0] == 0:
            done += 1
    return done


def _reloaded(n: int) -> str:
    return f"reloaded {n} kitt{'y' if n == 1 else 'ies'}" if n else "no running kitty found — the bar picks it up on its next redraw"


def features_cmd(argv: list[str]) -> int:
    """`kittymux features [list] | on|off NAME | preset minimal|default|full` — pick which optional pieces are on."""
    KF = kittymux_features
    sdir = KF.state_dir()
    cmd = argv[0] if argv else "list"
    usage = "usage: kittymux features [list] | on NAME | off NAME | preset minimal|default|full"
    if cmd in ("-h", "--help", "help"):
        print(usage)
        return 0
    try:
        if cmd in ("on", "off") and len(argv) == 2:
            KF.set_feature(sdir, argv[1], cmd == "on")
            note = ""
            if KF.source(argv[1], sdir)[1] == "env":         # only a value the resolver actually honours "wins"
                note = f"  {WARN} KITTYMUX_{argv[1].upper()} is set in this shell's environment and wins over this (kitty's own environment may differ)"
            if argv[1] in KF.PLANNED:
                note += f"  {WARN} not built yet — the choice is saved for when it exists, nothing changes today"
            print(f"{OK} {argv[1]} {cmd}{note}")
            print(c("2", f"  {_reloaded(_nudge_bars())}"))
            return 0
        if cmd == "preset" and len(argv) == 2:
            KF.apply_preset(sdir, argv[1])
            print(f"{OK} preset {argv[1]}: " + ", ".join(sorted(KF.PRESETS[argv[1]], key=KF.FEATURES.index)))
            print(c("2", f"  {_reloaded(_nudge_bars())}"))
            return 0
        if cmd in ("list", "status") and len(argv) <= 1:
            for name in KF.FEATURES:
                on, where = KF.source(name, sdir)
                print(f"  {name:<10} {'on ' if on else 'off'}  {c('2', where):<18} {FEATURE_HELP[name]}")
            print(c("2", "\n  presets: minimal (folder only) · default · full     kittymux features off hue"))
            return 0
    except ValueError as e:
        print(f"{BAD} {e}", file=sys.stderr)
        return 2
    except OSError as e:                                     # a read-only state directory, a directory named `hue-off`, …
        print(f"{BAD} cannot save the setting in {sdir}: {e}", file=sys.stderr)
        return 1
    print(usage, file=sys.stderr)
    return 2


def _key_clashes() -> list:
    """Chords both YOUR kitty config and kittymux's rendered keys file define with different actions. Never raises."""
    try:
        with open(os.path.join(CFG, "kittymux-keys.conf"), encoding="utf-8") as f:
            ours = f.read()
        return kittymux_keymap.conflicts(ours, kittymux_keymap.user_map_sources(CFG))
    except Exception:
        return []


def keys_cmd(argv: list[str]) -> int:
    """`kittymux keys [conflicts]` — the chords your own kitty config and kittymux both define. kitty reads kittymux-keys.conf AFTER your files and the
    last definition wins, so for each of these kittymux's action is the one in effect and yours is switched off. (Most are intended: kittymux's scripts
    replace your older ones. Anything else: rebind ours in the template, or remove yours.)"""
    if argv and argv[0] not in ("conflicts",):
        print("usage: kittymux keys [conflicts]", file=sys.stderr)
        return 2
    clashes = _key_clashes()
    if not clashes:
        print(f"{OK} no chord is defined by both your kitty config and kittymux")
        return 0
    print(f"{WARN} {len(clashes)} chords are defined by both your kitty config and kittymux — kittymux's loads later, so ITS action is the one in effect:\n")
    short = lambda s: s if len(s) <= 96 else s[:95] + "…"        # noqa: E731
    for chord, source, yours, ours in clashes:
        print(f"  {c('1', chord)}")
        print(f"      yours ({source}): {short(yours)}")
        print(f"      ours:  {short(ours)}")
    return 0


def peek_cmd(argv: list[str]) -> int:
    """`kittymux peek [TAB_ID | --waiting]` — open the peek card (what a right-click on a tab opens) over this pane: for this tab, for a tab of this kitty, or for the agent that
    has waited on you longest (`--waiting`, what ctrl+alt+shift+q does). The card shows the tab's state, the question, branch, folder, panes and the tail of its screen;
    ⏎ jumps there, esc closes. It acts on the kitty it was started inside, because the card can only show windows of the kitty it runs in."""
    usage = "usage: kittymux peek [TAB_ID | --waiting]"
    if len(argv) > 1 or (argv and not (argv[0] == "--waiting" or argv[0].isdigit())):
        print(usage, file=sys.stderr)
        return 2
    sock = _own_kitty_socket()
    if sock is None:
        print("kittymux peek: run it from a pane of the kitty you want to look at "
              "(needs allow_remote_control socket-only and listen_on unix:${XDG_RUNTIME_DIR}/mykitty)", file=sys.stderr)
        return 1
    data = _ls(sock) or []
    panes = [w for o in data for t in o.get("tabs", []) for w in t.get("windows", [])]
    mine = os.environ.get("KITTY_WINDOW_ID", "")
    # $KITTY_WINDOW_ID is the pane you ran it from in a shell; a key-bound `launch --type=background` gets the id of its own hidden window instead, which is no pane of any tab
    win = mine if mine.isdigit() and any(w.get("id") == int(mine) for w in panes) else next((str(w["id"]) for w in panes if w.get("is_focused")), "")
    if not win:
        print("kittymux peek: no focused pane in this kitty to show the card over", file=sys.stderr)
        return 1

    def tab_of_window(window_id: int):
        return next((t["id"] for o in data for t in o.get("tabs", []) for w in t.get("windows", []) if w.get("id") == window_id), None)

    if argv and argv[0] == "--waiting":
        now = time.time()
        events, windows, closed, installed = _pick_data(now)
        rows = kittymux_launcher.build_rows(events, windows, closed, installed, now, home=os.path.expanduser("~"))
        target = kittymux_launcher.needs_you_target(rows, _socket_pid(sock))
        if target is None:
            print("kittymux peek: no agent in this kitty needs you (`kittymux pick` also lists other kitties)", file=sys.stderr)
            _notify("nothing needs you")
            return 1
        tab = tab_of_window(int(target))
    elif argv:
        tab = int(argv[0]) if any(t.get("id") == int(argv[0]) for o in data for t in o.get("tabs", [])) else None
        if tab is None:
            print(f"kittymux peek: no tab {argv[0]} in this kitty (see `kitty @ ls`)", file=sys.stderr)
            return 1
    else:
        tab = tab_of_window(int(win))
    if tab is None:
        print("kittymux peek: that tab is gone", file=sys.stderr)
        return 1
    kit = os.path.join(HOME_DIR, "python", "peek-kit.py")
    r = subprocess.run(["kitty", "@", "--to", sock, "kitten", "--match", f"id:{win}", kit, str(tab)], stdin=subprocess.DEVNULL, check=False)
    return r.returncode


def _pane_to_cover(sock: str) -> str:
    """The pane an overlay should open over: $KITTY_WINDOW_ID when it is a real pane of that kitty (a shell), else the focused pane (a key-bound background command gets the id
    of its own hidden window, which is no pane of any tab)."""
    panes = [w for o in (_ls(sock) or []) for t in o.get("tabs", []) for w in t.get("windows", [])]
    mine = os.environ.get("KITTY_WINDOW_ID", "")
    return mine if mine.isdigit() and any(w.get("id") == int(mine) for w in panes) else next((str(w["id"]) for w in panes if w.get("is_focused")), "")


def palette_cmd(argv: list[str]) -> int:
    """`kittymux palette` — the command palette over this pane (what ctrl+alt+shift+space opens): type to find a tab, an agent that needs you, a conversation to
    reopen, a new agent or a fixed action; ⏎ does it. It acts on the kitty it was started inside."""
    if argv:
        print("usage: kittymux palette", file=sys.stderr)
        return 2
    sock = _own_kitty_socket()
    if sock is None:
        print("kittymux palette: run it from a pane of the kitty you want to use "
              "(needs allow_remote_control socket-only and listen_on unix:${XDG_RUNTIME_DIR}/mykitty)", file=sys.stderr)
        return 1
    win = _pane_to_cover(sock)
    if not win:
        print("kittymux palette: no focused pane in this kitty to open it over", file=sys.stderr)
        return 1
    kit = os.path.join(HOME_DIR, "python", "palette-kit.py")
    return subprocess.run(["kitty", "@", "--to", sock, "kitten", "--match", f"id:{win}", kit], stdin=subprocess.DEVNULL, check=False).returncode


def act_cmd(argv: list[str]) -> int:
    """`kittymux act JSON` — do ONE command-palette action. The palette's kitten calls it after it closes; it is not meant to be typed. The action is validated again (a tab id,
    an agent that is installed, one of a few fixed ids): anything else is refused and nothing runs."""
    if len(argv) != 1:
        print("usage: kittymux act JSON   (what the command palette runs; see `kittymux palette`)", file=sys.stderr)
        return 2
    try:
        obj = json.loads(argv[0])
    except ValueError:
        print("kittymux act: not JSON", file=sys.stderr)
        return 2
    a = kittymux_palette.validate_action(obj, known_agents=tuple(_installed_agents()))
    if a is None:
        print("kittymux act: not an action the palette can run", file=sys.stderr)
        return 2
    sock = _own_kitty_socket() or _focused_socket()
    op = a["op"]
    if op == "focus-tab":
        if not sock:
            print("kittymux act: no kitty to act on", file=sys.stderr)
            return 1
        rc, _ = _run(["kitty", "@", "--to", sock, "focus-tab", "--match", f"id:{a['tab']}"], 4)
        if rc == 0:
            _focus_wm(_socket_pid(sock))
        return 0 if rc == 0 else 1
    if op == "jump":
        rc = inbox_jump({"pid": a["pid"], "w": a["w"]})
        if rc == 0 and a.get("ack"):
            kittymux_inbox.ack(kittymux_layout.state_dir(), time.time(), ids=[a["ack"]])
        return rc
    if op == "run":
        return subprocess.run([os.path.join(HOME_DIR, "bin", "kittymux"), *kittymux_palette.ACTIONS[a["id"]][2]], check=False).returncode
    return _do_row({"action": a}, "open", sock)               # reopen | spawn | usage: the same code `pick` runs


def panel_cmd(argv: list[str]) -> int:
    action = argv[0] if argv else "toggle"
    if action not in {"toggle", "start", "stop", "status", "wider", "narrower", "width"} or (action == "width" and (len(argv) != 2 or not argv[1].isdigit())) or (action != "width" and len(argv) > 1):
        print("usage: kittymux panel [toggle|start|stop|status|wider|narrower|width N]", file=sys.stderr)
        return 2
    return subprocess.run([os.path.join(HOME_DIR, "bin/mux-panel"), *(argv or ["toggle"])], check=False).returncode


def usage_cmd(argv: list[str]) -> int:
    """Usage overlay inside this kitty, or a separate window accessible from any app."""
    if any(a != "--window" for a in argv):
        print("usage: kittymux usage [--window]", file=sys.stderr)
        return 2
    program = os.path.join(HOME_DIR, "bin", "mux-usage.py")
    sock = _own_kitty_socket() if "--window" not in argv else None
    win = os.environ.get("KITTY_WINDOW_ID", "")
    try:
        if sock and win.isdigit():
            r = subprocess.run(["kitty", "@", "--to", sock, "launch", "--match", f"id:{win}", "--type=overlay",
                                "--title", "kittymux-usage", "python3", program], stdin=subprocess.DEVNULL, check=False)
            return r.returncode
        child_env = dict(os.environ)
        for key in ("KITTY_PID", "KITTY_WINDOW_ID", "KITTY_LISTEN_ON", "KITTYMUX_TARGET"):
            child_env.pop(key, None)
        subprocess.Popen(["kitty", "--class", "kittymux-usage", "--title", "kittymux-usage",
                          "-o", "tab_bar_min_tabs=9999", "-o", "initial_window_width=86c", "-o", "initial_window_height=32c",
                          "python3", program], env=child_env, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0
    except OSError:
        print("kittymux usage: could not open kitty", file=sys.stderr)
        return 1


def join_cmd(argv: list[str]) -> int:
    """`kittymux join [--to TAB] [--side right|below|left|above|auto] [--pane]` — move this tab's panes into another tab as splits, keeping their shape.
    Without --to it opens the picker over this pane (what ctrl+alt+shift+j does). Acts on the kitty it was started inside and on THIS pane's tab."""
    usage = "usage: kittymux join [--to TAB_ID] [--side right|below|left|above|auto] [--pane]"
    args, it = [], iter(argv)
    for a in it:
        if a == "--to":
            v = next(it, "")
            if not v.isdigit():
                print(usage, file=sys.stderr)
                return 2
            args += ["--to", v]
        elif a == "--side":
            v = next(it, "")
            if v not in ("right", "below", "left", "above", "auto"):
                print(usage, file=sys.stderr)
                return 2
            args += ["--side", v]
        elif a == "--pane":
            args.append("--pane")
        else:
            print(usage, file=sys.stderr)
            return 2
    sock, win = _own_kitty_socket(), os.environ.get("KITTY_WINDOW_ID", "")
    if sock is None or not win.isdigit():
        print("kittymux join: run it from a pane of the kitty whose tab you want to move "
              "(needs allow_remote_control socket-only and listen_on unix:${XDG_RUNTIME_DIR}/mykitty)", file=sys.stderr)
        return 1
    kit = os.path.join(HOME_DIR, "python", "join-kit.py")
    r = subprocess.run(["kitty", "@", "--to", sock, "kitten", "--match", f"id:{win}", kit, *args], stdin=subprocess.DEVNULL, check=False)
    return r.returncode


def snooze(argv: list[str]) -> int:
    """`kittymux snooze [1h] [--window ID] [--clear]` — no popups or bells for ONE agent window for a while (its events still reach the inbox). Stored in the private state dir
    (kittymux_quiet), never as a window variable: a program in the window could set that itself and silence its own "needs you"."""
    clear = "--clear" in argv
    wid = next((argv[i + 1] for i, a in enumerate(argv[:-1]) if a == "--window"), os.environ.get("KITTY_WINDOW_ID", ""))
    span = parse_duration(next((a for a in argv if _DURATION.match(a)), "1h"))
    if not str(wid).isdigit():
        print("usage: kittymux snooze [30m|1h|2d] [--window ID] [--clear]   (run it inside the window, or give --window)", file=sys.stderr)
        return 2
    if span is None or span <= 0 or span > kittymux_quiet.MAX_SPAN_S:
        print("kittymux snooze: a duration like 30m, 1h or 2d (up to 30 days)", file=sys.stderr)
        return 2
    sock = _target_socket()
    pid = _socket_pid(sock) if sock else None
    if not sock or pid is None:
        print("kittymux snooze: no kitty remote-control socket found", file=sys.stderr)
        return 1
    if not any(str(w.get("id")) == str(wid) for o in (_ls(sock) or []) for t in o.get("tabs", []) for w in t.get("windows", [])):
        print(f"kittymux snooze: kitty has no window {wid}", file=sys.stderr)
        return 1
    sdir = kittymux_layout.state_dir()
    if clear:
        kittymux_quiet.clear_snooze(sdir, pid, wid)
        print(f"{OK} snooze cleared")
        return 0
    until = kittymux_quiet.set_snooze(sdir, pid, wid, span)
    print(f"{OK} window {wid} snoozed until {time.strftime('%H:%M', time.localtime(until))}")
    return 0


# ── explain ──────────────────────────────────────────────────────────────────
def describe_event(ev: dict) -> str:
    """One decision-log event as a human sentence (kittymux_scan._record writes them)."""
    if ev.get("kind") == "state":
        arrow = f"{ev.get('frm') or '·'} → {ev.get('to') or '·'}"
        return f"{arrow:<20} {ev.get('why', '')}"
    if ev.get("kind") == "attention":
        return f"{'window-manager bell':<20} {ev.get('outcome', '')}"
    if ev.get("kind") == "agent-notification":
        return f"{'it announced ' + str(ev.get('what', '')):<20} {ev.get('outcome', '')}"
    if ev.get("kind") == "notify":
        worked = f" (worked {ev['worked']} s)" if ev.get("worked") is not None else ""
        return f"{'notify ' + str(ev.get('state', '')):<20} {ev.get('outcome', '')}{worked}"
    return json.dumps(ev, sort_keys=True)


def read_events(path: str, last: int = 25, wid: str | None = None) -> list[dict]:
    """The newest `last` decisions in a decisions-<pid>.jsonl (optionally one window's). Bad lines are skipped; a missing file is empty."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return []
    out = []
    for line in lines[-2000:]:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if isinstance(ev, dict) and (wid is None or str(ev.get("w")) == wid):
            out.append(ev)
    return out[-max(1, last):]


def explain(argv: list[str]) -> int:
    """`explain [--window ID] [--last N] [--all] [--json]`: the current state of every agent pane with the reason, then the recent decisions."""
    wid, last, every, as_json = None, 25, False, False
    it = iter(argv)
    for a in it:
        if a == "--window":
            wid = next(it, "")
        elif a == "--last":
            try:
                last = int(next(it, ""))
            except ValueError:
                print("kittymux explain: --last needs a number", file=sys.stderr)
                return 2
        elif a == "--all":
            every = True
        elif a == "--json":
            as_json = True
        else:
            print("usage: kittymux explain [--window ID] [--last N] [--all] [--json]", file=sys.stderr)
            return 2
    if wid is not None and not wid.isdigit():
        print("kittymux explain: --window needs a window id (kitty @ ls)", file=sys.stderr)
        return 2
    socks = _sockets() if every else ([s] if (s := _target_socket()) else [])
    if not socks:
        print("kittymux explain: no kitty remote-control socket found (set allow_remote_control socket-only and listen_on unix:${XDG_RUNTIME_DIR}/mykitty in kitty.conf)", file=sys.stderr)
        return 1
    state_dir = kittymux_layout.state_dir()
    report = []
    for sock in socks:
        pid = _socket_pid(sock)
        if pid is None:
            continue
        titles = {}
        rc, out = _run(["kitty", "@", "--to", sock, "ls"], 4)
        try:
            for osw in json.loads(out) if rc == 0 else []:
                for tab in osw.get("tabs", []):
                    for w in tab.get("windows", []):
                        titles[str(w["id"])] = tab.get("title", "")
        except (ValueError, KeyError, TypeError):
            pass
        try:
            with open(os.path.join(state_dir, f"scan-{pid}.json"), encoding="utf-8") as f:
                verdicts = json.load(f)
        except (OSError, ValueError):
            verdicts = {}
        now = {w: v for w, v in verdicts.items() if isinstance(v, dict) and v.get("state") and (wid is None or w == wid)}
        report.append({"pid": pid, "now": now, "titles": titles,
                       "events": read_events(os.path.join(state_dir, f"decisions-{pid}.jsonl"), last, wid)})
    if as_json:
        print(json.dumps(report, indent=1, sort_keys=True))
        return 0
    for r in report:
        print(c("1", f"kitty {r['pid']}"))
        if not r["now"]:
            print("  no agent panes right now" + (f" in window {wid}" if wid else ""))
        for w, v in sorted(r["now"].items(), key=lambda kv: int(kv[0])):
            title = (r["titles"].get(w, "") or "")[:28]
            state_txt = c("1", "%-8s" % v.get("state", ""))
            print("  win %-5s %-12s %s %-28s %s" % (w, v.get("agent", ""), state_txt, title, c("2", v.get("why", ""))))
        print(c("2", "\n  recent decisions (oldest first):") if r["events"] else c("2", "\n  no decisions recorded yet — they appear as agents change state"))
        for ev in r["events"]:
            clock = time.strftime("%H:%M:%S", time.localtime(float(ev.get("t", 0))))
            print("  %s  win %-5s %-10s %s" % (clock, ev.get("w", "?"), ev.get("agent", ""), describe_event(ev)))
        print()
    return 0


# ── dim inactive panes / screenshots (kitty ≥ 0.49.2 features) ───────────────
def dim(argv: list[str]) -> int:
    """`dim [on|off|toggle|show]`: kitty's built-in `dim-inactive-windows` shader for panes that are not focused.
    A flag file turns it on for every kitty that understands it (kittymux_layout.gated_conf decides per version)."""
    cmd = argv[0] if argv else "toggle"
    flag = os.path.join(kittymux_layout.state_dir(), kittymux_layout.DIM_FLAG)
    on = os.path.exists(flag)
    if cmd == "show":
        print("dim inactive panes: " + ("on" if on else "off"))
        return 0
    if cmd not in ("on", "off", "toggle"):
        print("usage: kittymux dim [on|off|toggle|show]", file=sys.stderr)
        return 2
    want = (not on) if cmd == "toggle" else cmd == "on"
    if want and not kittymux_layout.have_slangc():
        print(f"{BAD} dimming needs kitty's shader compiler, which is not installed: add the `shader-slang` package "
              "(Arch: pacman -S shader-slang; or set $SLANGC to your slangc)", file=sys.stderr)
        return 1
    if want:
        os.makedirs(os.path.dirname(flag), mode=0o700, exist_ok=True)
        open(flag, "a").close()
    elif on:
        os.unlink(flag)
    ver = _kitty_version()
    if want and ver and ver < kittymux_layout.DIM_SHADER_MIN:
        print(f"{WARN} kitty {'.'.join(map(str, ver))} is older than 0.49.2 — the flag is set, "
              "but it takes effect only on kitty ≥ 0.49.2 (older ones also dim the tab bar)")
    sock = _target_socket()
    if sock:
        _run(["kitty", "@", "--to", sock, "load-config"], 6)
    print("dim inactive panes: " + ("on" if want else "off"))
    return 0


def screenshot(argv: list[str]) -> int:
    """`screenshot [--tab|--window] [FILE]`: kitty's own PNG of the OS window (tab bar included), the active tab, or the focused
    window. The file is private (0600): a screenshot of agent sessions can hold anything that was on screen."""
    scope = "os"
    rest = []
    for a in argv:
        if a in ("--tab", "--window"):
            scope = a[2:]
        elif a.startswith("-"):
            print("usage: kittymux screenshot [--tab|--window] [FILE]", file=sys.stderr)
            return 2
        else:
            rest.append(a)
    sock = _target_socket()
    if not sock:
        print("kittymux screenshot: no kitty remote-control socket found", file=sys.stderr)
        return 1
    out = os.path.abspath(os.path.expanduser(rest[0])) if rest else os.path.join(
        os.environ.get("XDG_PICTURES_DIR") or os.path.expanduser("~/Pictures"), time.strftime("kittymux-%Y%m%d-%H%M%S.png"))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    match = {"os": [], "tab": ["--match-tab", "state:focused"], "window": ["--match", "state:focused"]}[scope]
    rc, _ = _run(["kitten", "@", "--to", sock, "screenshot", *match, out], 15)
    if rc != 0 or not os.path.exists(out):
        print("kittymux screenshot: kitty could not take it (needs kitty ≥ 0.49 and a visible window)", file=sys.stderr)
        return 1
    os.chmod(out, 0o600)
    print(out)
    return 0


# ── hooks ────────────────────────────────────────────────────────────────────
# PostToolUse → working: the agent itself says a tool call finished and it carries on (a permission you answered is
# no longer "waiting", and a quiet screen between tool calls is not "done"). SessionEnd → idle clears leftovers.
HOOK_EVENTS = {"UserPromptSubmit": "working", "PostToolUse": "working", "Notification": "waiting", "Stop": "done",
               "SessionEnd": "idle"}


def hook_command(state: str) -> str:
    return f"{os.path.join(HOME_DIR, 'bin', 'mux-status')} {state}"


def merge_hooks(settings: dict) -> tuple[dict, list[str]]:
    """Add our three hooks to a Claude Code settings dict without disturbing anything
    else. Idempotent. Returns (new settings, events added)."""
    settings = json.loads(json.dumps(settings))            # deep copy
    hooks = settings.setdefault("hooks", {})
    added = []
    for event, state in HOOK_EVENTS.items():
        groups = hooks.setdefault(event, [])
        already = any("mux-status" in h.get("command", "")
                      for g in groups for h in g.get("hooks", []))
        if not already:
            groups.append({"hooks": [{"type": "command", "command": hook_command(state)}]})
            added.append(event)
    return settings, added


def remove_hooks(settings: dict) -> tuple[dict, list[str]]:
    """Take exactly our hooks (commands that call mux-status) back out of a Claude Code
    settings dict, leaving every other hook untouched and dropping only the containers we
    emptied. Returns (new settings, events removed)."""
    settings = json.loads(json.dumps(settings))            # deep copy
    hooks = settings.get("hooks")
    removed = []
    if not isinstance(hooks, dict):
        return settings, removed
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for g in groups:
            inner = g.get("hooks", []) if isinstance(g, dict) else []
            keep = [h for h in inner if "mux-status" not in str(h.get("command", ""))]
            if len(keep) != len(inner):
                if event not in removed:
                    removed.append(event)
                if not keep:
                    continue                              # a group that only held our hook
                g = dict(g, hooks=keep)
            kept_groups.append(g)
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if removed and not hooks:                                # only drop a container we emptied
        del settings["hooks"]
    return settings, removed


def _write_settings(path: str, data: dict) -> None:
    """Backup, then atomic write that never widens the file's permissions."""
    if os.path.exists(path):
        stem = f"{path}.bak-kittymux-{time.strftime('%Y%m%d-%H%M%S')}"
        backup, n = stem, 1
        while os.path.exists(backup):                       # never overwrite an earlier backup
            n += 1
            backup = f"{stem}-{n}"
        shutil.copy2(path, backup)
        print(f"  backup: {backup}")
    tmp = path + ".tmp-kittymux"
    mode = stat.S_IMODE(os.stat(path).st_mode) if os.path.exists(path) else 0o600
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)      # never wider than the original
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def hooks(argv: list[str]) -> int:
    path = os.path.expanduser("~/.claude/settings.json")
    if "--settings" in argv:
        path = argv[argv.index("--settings") + 1]
    if "--install" not in argv and "--remove" not in argv:
        snippet, _ = merge_hooks({})
        print(f"Add to {path} (or run: kittymux hooks --install):\n")
        print(json.dumps(snippet, indent=2))
        print("\nRemove again any time with: kittymux hooks --remove (backs up first, touches only mux-status entries)")
        return 0
    try:
        current = json.load(open(path, encoding="utf-8")) if os.path.exists(path) else {}
    except ValueError:
        print(f"{BAD} {path} is not valid JSON — not touching it", file=sys.stderr)
        return 1
    if "--remove" in argv:
        pruned, gone = remove_hooks(current)
        if not gone:
            print(f"{OK} no kittymux hooks in {path} — nothing to remove")
            return 0
        _write_settings(path, pruned)
        print(f"{OK} removed {', '.join(gone)} from {path} (other hooks untouched)")
        return 0
    merged, added = merge_hooks(current)
    if not added:
        print(f"{OK} hooks already installed in {path}")
        return 0
    _write_settings(path, merged)
    print(f"{OK} added {', '.join(added)} → {path}")
    print("  new Claude Code sessions pick this up; the tab dot flips working/waiting/done.")
    return 0


# ── upgrade ──────────────────────────────────────────────────────────────────
def upgrade(argv: list[str]) -> int:
    """After `git pull`: refresh symlinks (install.sh), then reload every running kitty TWICE.
    Kitty caches imported helper modules, and the tab bar reloads them on (re)load — the first
    reload pulls in new files, the second draws with them. Sessions and processes are untouched."""
    if "--no-install" not in argv:
        print(c("1", "refreshing install…"))
        rc = subprocess.run([os.path.join(HOME_DIR, "install.sh")], stdout=subprocess.DEVNULL).returncode
        if rc != 0:
            print(f"{BAD} install.sh failed (rc={rc}) — run it by hand to see why", file=sys.stderr)
            return 1
        print(f"  {OK} symlinks and rendered keys up to date")
    socks = _sockets()
    if not socks:
        print(f"  {WARN} no kitty remote-control socket found — restart kitty to pick up the update")
    for sock in socks:
        ok = all(_run(["kitty", "@", "--to", sock, "load-config"], 8)[0] == 0 for _ in range(2))
        print(f"  {OK if ok else WARN} reloaded {sock}" + ("" if ok else " (failed — reload it with ctrl+shift+alt+r)"))
        time.sleep(0.5)
    print()
    return doctor()


# ── uninstall ────────────────────────────────────────────────────────────────
_MANAGED_FILES = ("kittymux-keys.conf", "kittymux-leader.conf", "include-tab-edge.conf", "include-tab-bar.conf", "open-actions.conf")


def _is_ours(path: str) -> bool:
    """A file install.sh rendered (it starts with kittymux's marker), not one you wrote yourself."""
    try:
        with open(path, encoding="utf-8") as f:
            return f.readline().startswith("# kittymux —")
    except OSError:
        return False


def plan_uninstall(cfg_dir: str, home_dir: str, font_dir: str, bin_dir: str | None = None) -> dict:
    """What install.sh put in place, found by looking — nothing is removed here.
    {"conf_lines": [...], "links": [...], "files": [...], "font": path|None}"""
    conf = os.path.join(cfg_dir, "kitty.conf")
    ours = {f"include {os.path.join(cfg_dir, n)}" for n in ("kittymux-keys.conf", "kittymux-leader.conf",
                                                            "include-tab-edge.conf")}
    ours |= {f"include {os.path.join(home_dir, 'kittymux.conf')}",
             f"geninclude {os.path.join(home_dir, 'python', 'kittymux_layout.py')}"}
    try:
        with open(conf, encoding="utf-8") as f:
            lines = [ln.rstrip("\n") for ln in f]
    except OSError:
        lines = []
    py_dir = os.path.join(home_dir, "python")
    links = []
    try:
        for name in sorted(os.listdir(cfg_dir)):
            path = os.path.join(cfg_dir, name)
            if (name in ("tab_bar.py", "window_title_bar.py") or name.startswith("kittymux_")) and os.path.islink(path) \
                    and os.path.realpath(path).startswith(os.path.realpath(py_dir) + os.sep):
                links.append(path)
    except OSError:
        pass
    cmd = os.path.join(bin_dir, "kittymux") if bin_dir else ""
    if cmd and os.path.islink(cmd) and os.path.realpath(cmd) == os.path.realpath(os.path.join(home_dir, "bin", "kittymux")):
        links.append(cmd)                          # the PATH command install.sh made (a file of yours by that name is not touched)
    files = [os.path.join(cfg_dir, n) for n in _MANAGED_FILES if os.path.isfile(os.path.join(cfg_dir, n))
             and (n != "open-actions.conf" or _is_ours(os.path.join(cfg_dir, n)))]
    font = os.path.join(font_dir, "kittymux-icons.ttf")
    return {"conf_lines": [ln for ln in lines if ln.strip() in ours], "links": links, "files": files,
            "font": font if os.path.isfile(font) else None}


def apply_uninstall(plan: dict, cfg_dir: str, stamp: str) -> None:
    """Carry the plan out. kitty.conf is backed up first; only the exact lines install.sh added go."""
    conf = os.path.join(cfg_dir, "kitty.conf")
    if plan["conf_lines"] and os.path.isfile(conf):
        shutil.copy2(conf, f"{conf}.bak.kittymux-uninstall-{stamp}")
        with open(conf, encoding="utf-8") as f:
            kept = [ln for ln in f.read().split("\n") if ln.strip() not in set(plan["conf_lines"])]
        text = re.sub(r"\n{3,}", "\n\n", "\n".join(kept)).rstrip("\n") + "\n"
        with open(conf, "w", encoding="utf-8") as f:
            f.write(text)
    for path in plan["links"] + plan["files"] + ([plan["font"]] if plan["font"] else []):
        try:
            os.unlink(path)
        except OSError:
            pass


def unsafe_purge_reason(path: str, home: str | None = None) -> str | None:
    """Why `uninstall --purge` must NOT delete `path` (it comes from $KITTYMUX_STATE, which can be mistyped): the root, your home or anything above it, a symlink, or a directory that
    does not look like kittymux's own (named `kittymux`, or holding files only kittymux writes). None = safe."""
    home = os.path.realpath(home or os.path.expanduser("~"))
    try:
        real = os.path.realpath(path)
        if os.path.islink(path):
            return f"{path} is a symlink"
        if not os.path.isdir(real):
            return None                                     # nothing there: nothing to delete
        if real == "/" or real == home or home.startswith(real.rstrip("/") + "/"):
            return f"{real} is your home directory or one above it"
        ours = ("inbox.jsonl", "agent-sessions.json", "scan-", "panes-", "layout-", "decisions-", "notify-mute-until", "sessions")
        names = os.listdir(real)
        if os.path.basename(real) != "kittymux" and not any(n.startswith(ours) for n in names):
            return f"{real} does not look like a kittymux state directory (set KITTYMUX_STATE to a directory named 'kittymux', or delete it yourself)"
    except OSError as e:
        return str(e)
    return None


def uninstall(argv: list[str]) -> int:
    """Take kittymux back out of kitty: the include lines, symlinks, generated files, icon font and
    Claude hooks. Dry run unless --yes; the state dir (layouts, caches) only goes with --purge."""
    yes, purge = "--yes" in argv, "--purge" in argv
    font_dir = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "fonts")
    bin_dir = os.environ.get("XDG_BIN_HOME") or os.path.expanduser("~/.local/bin")
    plan = plan_uninstall(CFG, HOME_DIR, font_dir, bin_dir)
    print(c("1", "kittymux uninstall") + ("" if yes else c("2", "  (dry run — nothing is changed)")))
    for ln in plan["conf_lines"]:
        print(f"  kitty.conf  - {ln}")
    for path in plan["links"] + plan["files"] + ([plan["font"]] if plan["font"] else []):
        print(f"  remove      {path}")
    print(f"  Claude Code hooks: `kittymux hooks --remove`" + ("" if yes else " (would run)"))
    if purge:
        print(f"  state dir   {STATE}")
    if not (plan["conf_lines"] or plan["links"] or plan["files"] or plan["font"]):
        print(f"  {OK} nothing of kittymux is installed in {CFG}")
    if not yes:
        print("\nrerun with --yes to do it" + (" (and --purge also deletes the state dir)" if not purge else ""))
        return 0
    apply_uninstall(plan, CFG, time.strftime("%Y%m%d-%H%M%S"))
    hooks(["--remove"])
    if purge:
        why = unsafe_purge_reason(STATE)
        if why:
            print(f"{BAD} not deleting the state dir: {why}", file=sys.stderr)
        else:
            shutil.rmtree(STATE, ignore_errors=True)
    if shutil.which("fc-cache"):
        subprocess.run(["fc-cache", "-f", font_dir], capture_output=True)
    print(f"\n{OK} removed. Running kitties keep their loaded config until reloaded (ctrl+shift+alt+r) or restarted;")
    print("  until then their tab bar keeps working. Your kitty.conf backup: kitty.conf.bak.kittymux-uninstall-*")
    return 0


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "help"
    if cmd == "uninstall":
        return uninstall(argv[1:])
    if cmd == "doctor":
        return doctor()
    if cmd == "upgrade":
        return upgrade(argv[1:])
    if cmd == "demo":
        return demo(argv[1:])
    if cmd == "hooks":
        return hooks(argv[1:])
    if cmd == "layout":
        return layout(argv[1:])
    if cmd == "dim":
        return dim(argv[1:])
    if cmd == "explain":
        return explain(argv[1:])
    if cmd == "inbox":
        return inbox(argv[1:])
    if cmd == "sessions":
        return sessions(argv[1:])
    if cmd == "resume-prompt":
        return resume_prompt(argv[1:])
    if cmd == "spawn":
        return spawn(argv[1:])
    if cmd == "pick":
        return pick(argv[1:])
    if cmd == "reopen":
        return reopen(argv[1:])
    if cmd == "notify":
        return notify_cmd(argv[1:])
    if cmd == "snooze":
        return snooze(argv[1:])
    if cmd == "features":
        return features_cmd(argv[1:])
    if cmd == "keys":
        return keys_cmd(argv[1:])
    if cmd == "join":
        return join_cmd(argv[1:])
    if cmd == "panel":
        return panel_cmd(argv[1:])
    if cmd == "usage":
        return usage_cmd(argv[1:])
    if cmd == "peek":
        return peek_cmd(argv[1:])
    if cmd == "palette":
        return palette_cmd(argv[1:])
    if cmd == "act":
        return act_cmd(argv[1:])
    if cmd == "fanout":
        return fanout(argv[1:])
    if cmd == "checkpoint":
        return checkpoint(argv[1:])
    if cmd == "changes":
        return changes_cmd(argv[1:])
    if cmd in ("pin", "unpin", "settle", "unsettle"):
        return lifecycle_verb(cmd, argv[1:])
    if cmd == "screenshot":
        return screenshot(argv[1:])
    if cmd in ("version", "--version", "-V"):
        print(f"kittymux {VERSION}")
        return 0
    print(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
