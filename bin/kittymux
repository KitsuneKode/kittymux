launch --location=hsplit sh -c 'printf "• Working (3m 2s • esc to interrupt)\\n"; exec -a codex sleep 86400'
new_tab notes
cd {home}
launch
focus_tab 1
"""


def demo(argv: list[str]) -> int:
    edge = "bottom" if "--bottom" in argv else "left"
    if not shutil.which("kitty"):
        print("kitty not found", file=sys.stderr)
        return 1
    tmp = tempfile.mkdtemp(prefix="kittymux-demo-")
    cfg, state = os.path.join(tmp, "cfg"), os.path.join(tmp, "state")
    os.makedirs(cfg)
    os.makedirs(state, mode=0o700)
    import glob
    for path in [os.path.join(HOME_DIR, "python", "tab_bar.py")] + sorted(glob.glob(os.path.join(HOME_DIR, "python", "kittymux_*.py"))):
        os.symlink(path, os.path.join(cfg, os.path.basename(path)))
    tpl = open(os.path.join(HOME_DIR, "kittymux-keys.conf.tpl"), encoding="utf-8").read()
    open(os.path.join(cfg, "kittymux-keys.conf"), "w").write(tpl.replace("@KITTYMUX_HOME@", HOME_DIR))
    ltpl = open(os.path.join(HOME_DIR, "kittymux-leader.conf.tpl"), encoding="utf-8").read()
    open(os.path.join(cfg, "kittymux-leader.conf"), "w").write(
        ltpl.replace("@KITTYMUX_HOME@", HOME_DIR).replace("@KITTYMUX_LEADER@", "ctrl+space"))
    open(os.path.join(cfg, "theme.conf"), "w").write(DEMO_THEME)
    env = dict(os.environ, KITTY_CONFIG_DIRECTORY=cfg, KITTYMUX_STATE=state, KITTYMUX_NOTIFY="0")
    fam = _fc_families()
    font_conf = "font_size 12\n"
    for cand in ("JetBrainsMono Nerd Font Mono", "CaskaydiaCove Nerd Font Mono", "FiraCode Nerd Font Mono",
                 "Hack Nerd Font Mono", "JetBrains Mono"):
        if cand.lower() in fam:
            font_conf += f"font_family {cand}\n"
            break
    if "symbols nerd font mono" in fam:
        font_conf += "symbol_map U+e000-U+e00a,U+e0a0-U+e0a3,U+e0b0-U+e0c8,U+e200-U+e2a9,U+e300-U+e3e3," \
                     "U+e5fa-U+e6b7,U+e700-U+e8ef,U+ea60-U+ec1e,U+ed00-U+efce,U+f000-U+f2ff,U+f300-U+f381," \
                     "U+f400-U+f533,U+f0001-U+f1af0 Symbols Nerd Font Mono\n"
    if "kittymux icons" not in fam or "--own-icon-font" in argv:
        # brand logos live in our own icon font — expose it to this window only
        data = os.path.join(tmp, "data")
        os.makedirs(os.path.join(data, "fonts"))
        shutil.copy(os.path.join(HOME_DIR, "assets", "kittymux-icons.ttf"), os.path.join(data, "fonts"))
        user_fonts = os.path.expanduser("~/.local/share/fonts")
        if os.path.isdir(user_fonts):
            os.symlink(user_fonts, os.path.join(data, "fonts", "user"))
        env["XDG_DATA_HOME"] = data
    open(os.path.join(cfg, "kitty.conf"), "w").write(
        font_conf + "allow_remote_control yes\nlisten_on unix:/tmp/mykitty\n"
        "include theme.conf\n"
        f"include {cfg}/kittymux-keys.conf\ninclude {cfg}/kittymux-leader.conf\n"
        f"include {HOME_DIR}/kittymux.conf\ntab_bar_edge {edge}\nwindow_padding_width 10\n"
        f"geninclude {HOME_DIR}/python/kittymux_layout.py\n")      # last: the collapse button / layout keys need it
    session = os.path.join(tmp, "demo.kitty")
    open(session, "w").write(DEMO_SESSION.format(home=os.path.expanduser("~")))

    print(c("1", "kittymux demo") + " — an isolated window; your config is untouched.\n")
    proc = subprocess.Popen(["kitty", "--class", "kittymux-demo", "--session", session], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sock = f"unix:/tmp/mykitty-{proc.pid}"
    for _ in range(60):
        if os.path.exists(sock[5:]):
            break
        time.sleep(0.1)
    time.sleep(1.5)

    print("  try:")
    print(f"    {c('1', 'ctrl+alt+b')}       sidebar deck — hover, click, live preview")
    print(f"    {c('1', 'ctrl+alt+y')}       jump to the agent that is waiting on you")
    print(f"    {c('1', 'ctrl+space')} then {c('1', '?')}   leader mode card")
    print(f"    {c('1', 'ctrl+alt+/')}       every key binding")
    print(f"\n  status is read from each agent's screen — ! waiting on you, a spinner while it works — and from `mux-status` hooks if you add them.")
    print("  close the kitty window to end the demo.\n")
    try:
        proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
    shutil.rmtree(tmp, ignore_errors=True)
    return 0


# ── layout ───────────────────────────────────────────────────────────────────
def _owned_socket(path: str) -> bool:
    """A kitty socket we may trust: a real socket owned by us (anyone can create files
    in /tmp — never send window contents to a socket someone else planted)."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    return stat.S_ISSOCK(st.st_mode) and st.st_uid == os.getuid()


def _target_socket() -> str | None:
    """The kitty instance this command was launched from.

    Order matters: an explicit KITTYMUX_TARGET; then our *actual parent process* (kitty
    itself spawns key-bound commands, so its PID names the right socket even if the
    environment is stale); only then environment hints; finally the newest socket we own."""
    explicit = os.environ.get("KITTYMUX_TARGET", "")
    if explicit.startswith("unix:") and _owned_socket(explicit[5:]):
        return explicit
    ppid = str(os.getppid())
    for d in _socket_dirs():
        if _owned_socket(f"{d}/mykitty-{ppid}"):
            return f"unix:{d}/mykitty-{ppid}"
    env = os.environ.get("KITTY_LISTEN_ON", "")
    if env.startswith("unix:") and _owned_socket(env[5:]):
        return env
    pid = os.environ.get("KITTY_PID", "")
    if pid.isdigit():
        for d in _socket_dirs():
            if _owned_socket(f"{d}/mykitty-{pid}"):
                return f"unix:{d}/mykitty-{pid}"
    import glob
    socks = sorted((g for d in _socket_dirs() for g in glob.glob(os.path.join(d, "mykitty-*")) if _owned_socket(g)),
                   key=lambda g: os.stat(g).st_mtime, reverse=True)
    return f"unix:{socks[0]}" if socks else None


def _socket_pid(sock: str) -> int | None:
    tail = sock.rsplit("-", 1)[-1]
    return int(tail) if tail.isdigit() else None


def _notify(msg: str) -> None:
    if os.environ.get("KITTYMUX_NOTIFY") == "0" or os.path.exists(os.path.join(STATE, "notify-off")):
        return                                     # same off-switch as the agent notifications
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "kittymux", "-t", "1400", "--", "tab bar", msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def layout(argv: list[str]) -> int:
    cmd = argv[0] if argv else "show"
    arg = argv[1] if len(argv) > 1 else ""
    sdir = kittymux_layout.state_dir()
    sock = _target_socket()
    pid = _socket_pid(sock) if sock else None
    if pid is None:
        print("kittymux layout: no kitty remote-control socket found "
              "(set listen_on unix:/tmp/mykitty in kitty.conf)", file=sys.stderr)
        return 1
    current = kittymux_layout.base_layout(sdir, pid, CFG)

    if cmd == "show":
        saved = kittymux_layout.load(sdir, pid)
        print(f"{kittymux_layout.describe(current)}  ({'saved for this kitty' if saved else 'from your kitty.conf'})")
        print("presets: " + ", ".join(kittymux_layout.PRESETS))
        return 0
    if cmd == "default":
        if arg == "clear":
            kittymux_layout.clear_default(sdir)
            print("default cleared — new kitty windows follow your kitty.conf until you choose a layout")
        else:
            kittymux_layout.pin_default(sdir, current)
            print(f"pinned as the default for new kitty windows: {kittymux_layout.describe(current)}")
        return 0
    if cmd == "pick":
        return _layout_pick(sock, sdir, pid, current)
    try:
        new = kittymux_layout.apply_command(current, cmd, arg)
    except ValueError as e:
        print(f"kittymux layout: {e}", file=sys.stderr)
        return 2
    return _apply_layout(sock, sdir, pid, new)


def _apply_layout(sock: str, sdir: str, pid: int, new) -> int:
    kittymux_layout.save(sdir, pid, new)
    rc, _ = _run(["kitty", "@", "--to", sock, "load-config"], 6)   # this instance only
    label = kittymux_layout.describe(new)
    if rc != 0:
        print(f"saved ({label}) but could not reload {sock} — reload it with ctrl+shift+alt+r", file=sys.stderr)
        return 1
    print(label)
    _notify(label)
    return 0


def _layout_pick(sock: str, sdir: str, pid: int, current) -> int:
    if not shutil.which("fzf"):
        print("fzf not found", file=sys.stderr)
        return 1
    here = kittymux_layout.describe(current)
    rows = [f"{name:<14}\t{desc}" for name, (lay, desc) in kittymux_layout.PRESETS.items()]
    colors = kittymux_theme.fzf_args(kittymux_theme.palette_from_kitty(sock))
    p = subprocess.run(
        ["fzf", "--ansi", "--layout=reverse", "--height=100%", "--border=rounded", "--margin=1,2",
         "--padding=1,2", "--delimiter=\t", "--with-nth=1,2", "--no-sort", "--cycle",
         "--prompt=  tab bar › ", f"--header=now: {here}", "--header-first",
         "--footer=enter: apply   esc: cancel", *colors],
        input="\n".join(rows), text=True, capture_output=True)
    if p.returncode != 0 or not p.stdout.strip():
        return 0
    name = p.stdout.split("\t", 1)[0].strip()
    return _apply_layout(sock, sdir, pid, kittymux_layout.apply_command(current, "preset", name))


# ── hooks ────────────────────────────────────────────────────────────────────
HOOK_EVENTS = {"UserPromptSubmit": "working", "Notification": "waiting", "Stop": "done"}


def hook_command(state: str) -> str:
    return f"{os.path.join(HOME_DIR, 'bin', 'mux-status')} {state}"


def merge_hooks(settings: dict) -> tuple[dict, list[str]]:
    """Add our three hooks to a Claude Code settings dict without disturbing anything
    else. Idempotent. Returns (new settings, events added)."""
    settings = json.loads(json.dumps(settings))            # deep copy
    hooks = settings.setdefault("hooks", {})
    added = []
    for event, state in HOOK_EVENTS.items():
        groups = hooks.setdefault(event, [])
        already = any("mux-status" in h.get("command", "")
                      for g in groups for h in g.get("hooks", []))
        if not already:
            groups.append({"hooks": [{"type": "command", "command": hook_command(state)}]})
            added.append(event)
    return settings, added


def remove_hooks(settings: dict) -> tuple[dict, list[str]]:
    """Take exactly our hooks (commands that call mux-status) back out of a Claude Code
    settings dict, leaving every other hook untouched and dropping only the containers we
    emptied. Returns (new settings, events removed)."""
    settings = json.loads(json.dumps(settings))            # deep copy
    hooks = settings.get("hooks")
    removed = []
    if not isinstance(hooks, dict):
        return settings, removed
    for event in list(hooks):
        groups = hooks[event]
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for g in groups:
            inner = g.get("hooks", []) if isinstance(g, dict) else []
            keep = [h for h in inner if "mux-status" not in str(h.get("command", ""))]
            if len(keep) != len(inner):
                if event not in removed:
                    removed.append(event)
                if not keep:
                    continue                              # a group that only held our hook
                g = dict(g, hooks=keep)
            kept_groups.append(g)
        if kept_groups:
            hooks[event] = kept_groups
        else:
            del hooks[event]
    if removed and not hooks:                                # only drop a container we emptied
        del settings["hooks"]
    return settings, removed


def _write_settings(path: str, data: dict) -> None:
    """Backup, then atomic write that never widens the file's permissions."""
    if os.path.exists(path):
        stem = f"{path}.bak-kittymux-{time.strftime('%Y%m%d-%H%M%S')}"
        backup, n = stem, 1
        while os.path.exists(backup):                       # never overwrite an earlier backup
            n += 1
            backup = f"{stem}-{n}"
        shutil.copy2(path, backup)
        print(f"  backup: {backup}")
    tmp = path + ".tmp-kittymux"
    mode = stat.S_IMODE(os.stat(path).st_mode) if os.path.exists(path) else 0o600
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)      # never wider than the original
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def hooks(argv: list[str]) -> int:
    path = os.path.expanduser("~/.claude/settings.json")
    if "--settings" in argv:
        path = argv[argv.index("--settings") + 1]
    if "--install" not in argv and "--remove" not in argv:
        snippet, _ = merge_hooks({})
        print(f"Add to {path} (or run: kittymux hooks --install):\n")
        print(json.dumps(snippet, indent=2))
        print("\nRemove again any time with: kittymux hooks --remove (backs up first, touches only mux-status entries)")
        return 0
    try:
        current = json.load(open(path, encoding="utf-8")) if os.path.exists(path) else {}
    except ValueError:
        print(f"{BAD} {path} is not valid JSON — not touching it", file=sys.stderr)
        return 1
    if "--remove" in argv:
        pruned, gone = remove_hooks(current)
        if not gone:
            print(f"{OK} no kittymux hooks in {path} — nothing to remove")
            return 0
        _write_settings(path, pruned)
        print(f"{OK} removed {', '.join(gone)} from {path} (other hooks untouched)")
        return 0
    merged, added = merge_hooks(current)
    if not added:
        print(f"{OK} hooks already installed in {path}")
        return 0
    _write_settings(path, merged)
    print(f"{OK} added {', '.join(added)} → {path}")
    print("  new Claude Code sessions pick this up; the tab dot flips working/waiting/done.")
    return 0


# ── upgrade ──────────────────────────────────────────────────────────────────
def upgrade(argv: list[str]) -> int:
    """After `git pull`: refresh symlinks (install.sh), then reload every running kitty TWICE.
    Kitty caches imported helper modules, and the tab bar reloads them on (re)load — the first
    reload pulls in new files, the second draws with them. Sessions and processes are untouched."""
    if "--no-install" not in argv:
        print(c("1", "refreshing install…"))
        rc = subprocess.run([os.path.join(HOME_DIR, "install.sh")], stdout=subprocess.DEVNULL).returncode
        if rc != 0:
            print(f"{BAD} install.sh failed (rc={rc}) — run it by hand to see why", file=sys.stderr)
            return 1
        print(f"  {OK} symlinks and rendered keys up to date")
    socks = _sockets()
    if not socks:
        print(f"  {WARN} no kitty remote-control socket found — restart kitty to pick up the update")
    for sock in socks:
        ok = all(_run(["kitty", "@", "--to", sock, "load-config"], 8)[0] == 0 for _ in range(2))
        print(f"  {OK if ok else WARN} reloaded {sock}" + ("" if ok else " (failed — reload it with ctrl+shift+alt+r)"))
        time.sleep(0.5)
    print()
    return doctor()


# ── uninstall ────────────────────────────────────────────────────────────────
_MANAGED_FILES = ("kittymux-keys.conf", "kittymux-leader.conf", "include-tab-edge.conf", "include-tab-bar.conf")


def plan_uninstall(cfg_dir: str, home_dir: str, font_dir: str) -> dict:
    """What install.sh put in place, found by looking — nothing is removed here.
    {"conf_lines": [...], "links": [...], "files": [...], "font": path|None}"""
    conf = os.path.join(cfg_dir, "kitty.conf")
    ours = {f"include {os.path.join(cfg_dir, n)}" for n in ("kittymux-keys.conf", "kittymux-leader.conf",
                                                            "include-tab-edge.conf")}
    ours |= {f"include {os.path.join(home_dir, 'kittymux.conf')}",
             f"geninclude {os.path.join(home_dir, 'python', 'kittymux_layout.py')}"}
    try:
        with open(conf, encoding="utf-8") as f:
            lines = [ln.rstrip("\n") for ln in f]
    except OSError:
        lines = []
    py_dir = os.path.join(home_dir, "python")
    links = []
    try:
        for name in sorted(os.listdir(cfg_dir)):
            path = os.path.join(cfg_dir, name)
            if (name == "tab_bar.py" or name.startswith("kittymux_")) and os.path.islink(path) \
                    and os.path.realpath(path).startswith(os.path.realpath(py_dir) + os.sep):
                links.append(path)
    except OSError:
        pass
    files = [os.path.join(cfg_dir, n) for n in _MANAGED_FILES if os.path.isfile(os.path.join(cfg_dir, n))]
    font = os.path.join(font_dir, "kittymux-icons.ttf")
    return {"conf_lines": [ln for ln in lines if ln.strip() in ours], "links": links, "files": files,
            "font": font if os.path.isfile(font) else None}


def apply_uninstall(plan: dict, cfg_dir: str, stamp: str) -> None:
    """Carry the plan out. kitty.conf is backed up first; only the exact lines install.sh added go."""
    conf = os.path.join(cfg_dir, "kitty.conf")
    if plan["conf_lines"] and os.path.isfile(conf):
        shutil.copy2(conf, f"{conf}.bak.kittymux-uninstall-{stamp}")
        with open(conf, encoding="utf-8") as f:
            kept = [ln for ln in f.read().split("\n") if ln.strip() not in set(plan["conf_lines"])]
        text = re.sub(r"\n{3,}", "\n\n", "\n".join(kept)).rstrip("\n") + "\n"
        with open(conf, "w", encoding="utf-8") as f:
            f.write(text)
    for path in plan["links"] + plan["files"] + ([plan["font"]] if plan["font"] else []):
        try:
            os.unlink(path)
        except OSError:
            pass


def uninstall(argv: list[str]) -> int:
    """Take kittymux back out of kitty: the include lines, symlinks, generated files, icon font and
    Claude hooks. Dry run unless --yes; the state dir (layouts, caches) only goes with --purge."""
    yes, purge = "--yes" in argv, "--purge" in argv
    font_dir = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "fonts")
    plan = plan_uninstall(CFG, HOME_DIR, font_dir)
    print(c("1", "kittymux uninstall") + ("" if yes else c("2", "  (dry run — nothing is changed)")))
    for ln in plan["conf_lines"]:
        print(f"  kitty.conf  - {ln}")
    for path in plan["links"] + plan["files"] + ([plan["font"]] if plan["font"] else []):
        print(f"  remove      {path}")
    print(f"  Claude Code hooks: `kittymux hooks --remove`" + ("" if yes else " (would run)"))
    if purge:
        print(f"  state dir   {STATE}")
    if not (plan["conf_lines"] or plan["links"] or plan["files"] or plan["font"]):
        print(f"  {OK} nothing of kittymux is installed in {CFG}")
    if not yes:
        print("\nrerun with --yes to do it" + (" (and --purge also deletes the state dir)" if not purge else ""))
        return 0
    apply_uninstall(plan, CFG, time.strftime("%Y%m%d-%H%M%S"))
    hooks(["--remove"])
    if purge:
        shutil.rmtree(STATE, ignore_errors=True)
    if shutil.which("fc-cache"):
        subprocess.run(["fc-cache", "-f", font_dir], capture_output=True)
    print(f"\n{OK} removed. Running kitties keep their loaded config until reloaded (ctrl+shift+alt+r) or restarted;")
    print("  until then their tab bar keeps working. Your kitty.conf backup: kitty.conf.bak.kittymux-uninstall-*")
    return 0


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "help"
    if cmd == "uninstall":
        return uninstall(argv[1:])
    if cmd == "doctor":
        return doctor()
    if cmd == "upgrade":
        return upgrade(argv[1:])
    if cmd == "demo":
        return demo(argv[1:])
    if cmd == "hooks":
        return hooks(argv[1:])
    if cmd == "layout":
        return layout(argv[1:])
    if cmd in ("version", "--version", "-V"):
        print(f"kittymux {VERSION}")
        return 0
    print(__doc__)
    return 0 if cmd in ("help", "-h", "--help") else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
