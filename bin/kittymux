DEMO_SESSION = """\
new_tab api
cd {home}
launch
new_tab claude
cd {home}
launch sh -c 'printf " Bash command\\n   rm -rf node_modules\\n Do you want to proceed?\\n ❯ 1. Yes\\n   2. No\\n"; exec -a claude sleep 86400'
