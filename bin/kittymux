#!/usr/bin/env python3
"""kittymux — helper CLI.

  kittymux doctor      check your install and tell you exactly how to fix what's off
  kittymux demo        try kittymux in an isolated window (your config is never touched)
  kittymux hooks       print the Claude Code hook config;  --install merges it (backup first)
  kittymux layout      switch this kitty's bar on the fly:
                         layout mode [full|compact|hidden|cycle]   layout edge [left|right|bottom|top|cycle]
                         layout width [+N|-N|N]   layout preset NAME   layout pick   layout show
                         layout default [clear]   (pin the current layout as the start for new windows; otherwise new kitties start with your last choice)
  kittymux inbox       everything that wants your attention (questions, permissions, usage limits, finished runs), newest first:
                         inbox [--all] [--json] [--limit N]   inbox ack [ID… | --all]   inbox clear   inbox jump [ID]   inbox watch
  kittymux explain     why each agent pane is in its state, and every recent decision (state changes, notifications sent or held back):
                         explain [--window ID] [--last N] [--all] [--json]
  kittymux dim         dim the panes that are not focused (kitty ≥ 0.49.2): dim [on|off|toggle|show]
  kittymux screenshot  PNG of this kitty window (kitty's own renderer): screenshot [--tab|--window] [FILE]
  kittymux upgrade     after a git pull: refresh links, reload every running kitty twice, run doctor
  kittymux uninstall   show what install.sh added (dry run); --yes removes it, --purge also deletes the state dir
  kittymux version

`demo` is the 30-second tour: a scratch kitty with a sample session, fake agents in
different states, and the real key bindings. Close the window when you're done.
"""

import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time

HOME_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(HOME_DIR, "python"))
import kittymux_agents  # noqa: E402
import kittymux_inbox  # noqa: E402
import kittymux_layout  # noqa: E402
import kittymux_theme  # noqa: E402

VERSION = "0.2.0"
TESTED_KITTY_MINOR = 49          # the kitty 0.<minor>.x the smoke tests run against
USE_COLOR = sys.stdout.isatty()


def c(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if USE_COLOR else text


OK, WARN, BAD = c("32", "✓"), c("33", "!"), c("31", "✗")
CFG = os.environ.get("KITTY_CONFIG_DIRECTORY") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "kitty")
STATE = os.environ.get("KITTYMUX_STATE") or os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "kittymux")


def banner() -> None:
    """The mascot, 64 px wide, via kitty's graphics protocol — only in a kitty window on a real terminal."""
    icon = os.path.join(HOME_DIR, "assets", "brand", "mascot-64.png")
    if sys.stdout.isatty() and os.environ.get("KITTY_WINDOW_ID") and shutil.which("kitten") and os.path.isfile(icon):
        try:
            subprocess.run(["kitten", "icat", "--align=left", "--transfer-mode=file", icon], timeout=3,
                           stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError):
            pass


# ── doctor ───────────────────────────────────────────────────────────────────
class Report:
    def __init__(self) -> None:
        self.bad = 0
        self.warn = 0

    def ok(self, msg: str) -> None:
        print(f"  {OK} {msg}")

    def warning(self, msg: str, fix: str = "") -> None:
        self.warn += 1
        print(f"  {WARN} {msg}")
        if fix:
            print(f"      {c('2', '→ ' + fix)}")

    def fail(self, msg: str, fix: str = "") -> None:
        self.bad += 1
        print(f"  {BAD} {msg}")
        if fix:
            print(f"      {c('2', '→ ' + fix)}")


def _run(cmd: list[str], timeout: float = 3.0) -> tuple[int, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except Exception:
        return 1, ""


def binary_replaced(pid: int) -> bool:
    """True when the kitty process `pid` is running a binary that has since been replaced on disk (a package update): it keeps
    running its old code but loads Python files from the NEW install on demand and at every config reload — a mixed state
    kitty does not support (tab clicks, drags and reloads can misbehave until it is restarted)."""
    try:
        return os.readlink(f"/proc/{pid}/exe").endswith(" (deleted)")
    except OSError:
        return False


def scanner_age(state_dir: str, pid: int, now: float | None = None) -> float | None:
    """Seconds since the scanner of kitty `pid` last wrote scan-<pid>.json (it rewrites on any change
    and at least every 3 s), or None if there is no such file."""
    try:
        mtime = os.stat(os.path.join(state_dir, f"scan-{pid}.json")).st_mtime
    except OSError:
        return None
    return max(0.0, (time.time() if now is None else now) - mtime)


def _kitty_version() -> tuple[int, int, int] | None:
    rc, out = _run(["kitty", "--version"])
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", out)
    return tuple(int(x) for x in m.groups()) if m else None  # type: ignore[return-value]


def _socket_dirs() -> list[str]:
    dirs = ["/tmp"]
    rt = os.environ.get("XDG_RUNTIME_DIR")
    if rt and os.path.isdir(rt):
        dirs.insert(0, rt)                     # the private place first
    return dirs


def _sockets() -> list[str]:
    """Kitty sockets we may trust: real sockets owned by us, in /tmp or $XDG_RUNTIME_DIR."""
    import glob
    socks = [s for d in _socket_dirs() for s in glob.glob(os.path.join(d, "mykitty-*")) if _owned_socket(s)]
    env = os.environ.get("KITTY_LISTEN_ON", "")
    ok_env = [env] if env.startswith("unix:") and _owned_socket(env[5:]) else []
    return list(dict.fromkeys(ok_env + [f"unix:{s}" for s in socks]))      # one entry per socket, order kept


def _fc_families() -> set:
    """Lower-cased font family names known to fontconfig."""
    if not shutil.which("fc-list"):
        return set()
    out = _run(["fc-list", ":", "family"], 8)[1]
    return {f.strip().lower() for line in out.splitlines() for f in line.split(",")}


def _conf_text(path: str, seen: set | None = None) -> str:
    """kitty.conf plus everything it includes (absolute or relative), best effort."""
    seen = seen or set()
    path = os.path.expanduser(path)
    if path in seen or not os.path.isfile(path):
        return ""
    seen.add(path)
    text = open(path, encoding="utf-8", errors="replace").read()
    out = [text]
    for m in re.finditer(r"^\s*include\s+(\S+)", text, re.M):
        inc = os.path.expanduser(m.group(1))
        if not os.path.isabs(inc):
            inc = os.path.join(os.path.dirname(path), inc)
        out.append(_conf_text(inc, seen))
    return "\n".join(out)


_KEYNAMES = {"comma": ",", "period": ".", "slash": "/", "semicolon": ";", "space": "space",
             "enter": "return", "bracketleft": "[", "bracketright": "]", "backslash": "\\",
             "minus": "-", "equal": "="}
_MOD_MASK = 1 | 4 | 8 | 64   # shift ctrl alt super — ignore caps/numlock bits


_MOD_BITS = {"shift": 1, "ctrl": 4, "control": 4, "alt": 8, "super": 64, "cmd": 64}
_KEY_ALIASES = {"left": "left", "right": "right", "up": "up", "down": "down", "enter": "return", "grave_accent": "`"}


def chords_in_tpl(tpl_text: str) -> list[tuple[str, int, str]]:
    """Every global chord a kittymux key template binds: (as written, modifier mask, key). Chords inside a
    leader/other mode (`map --mode …`) are not global and are skipped."""
    out = []
    for line in tpl_text.splitlines():
        m = re.match(r"^map\s+((?:--(?!mode)\S+\s+\S+\s+)*)(\S+)\s", line)
        if not m or line.startswith("map --mode"):
            continue
        parts = m.group(2).lower().split("+")
        mask = 0
        for p in parts[:-1]:
            mask |= _MOD_BITS.get(p, 0)
        key = parts[-1]
        out.append((m.group(2), mask, _KEYNAMES.get(key, _KEY_ALIASES.get(key, key))))
    return out


def conflicts_from_binds(binds: list, tpl_text: str) -> list[str]:
    """kittymux chords (any modifiers) that the window manager binds with EXACTLY those modifiers — the WM gets
    the key first, so kitty never sees it (or both react). A super+ctrl+alt bind is a different chord."""
    taken = {(b.get("modmask", 0) & _MOD_MASK, str(b.get("key", "")).lower()) for b in binds}
    return sorted({written for written, mask, key in chords_in_tpl(tpl_text) if (mask, key) in taken})


def _hypr_conflicts() -> list[str]:
    rc, out = _run(["hyprctl", "binds", "-j"])
    if rc != 0:
        return []
    try:
        binds = json.loads(out)
    except ValueError:
        return []
    tpl = os.path.join(HOME_DIR, "kittymux-keys.conf.tpl")
    return conflicts_from_binds(binds, open(tpl, encoding="utf-8").read())


def doctor() -> int:
    r = Report()
    banner()
    print(c("1", "kittymux doctor") + c("2", f"  {HOME_DIR}"))

    print("\nrequirements")
    ver = _kitty_version()
    if ver is None:
        r.fail("kitty not found", "install kitty ≥ 0.48 (0.49+ recommended)")
    elif ver < (0, 48, 0):
        r.fail(f"kitty {'.'.join(map(str, ver))} is too old", "vertical tabs need ≥ 0.48; 0.49+ recommended")
    elif ver >= (0, TESTED_KITTY_MINOR + 1, 0):
        r.warning(f"kitty {'.'.join(map(str, ver))} is newer than the tested 0.{TESTED_KITTY_MINOR}.x",
                  "kittymux wraps a few kitty internals (tab-bar mouse handling, tab hit-testing); if the bar "
                  "misbehaves after a kitty update, run `kittymux upgrade` and report it")
    elif ver < (0, 49, 2):
        r.warning(f"kitty {'.'.join(map(str, ver))}: update to 0.49.2 or newer",
                  "0.49.2 fixes a file-transfer confirmation bypass by a malicious remote program, lowers input latency, "
                  "makes tab drag-and-drop insert instead of swap, and adds clickable file:line references")
    else:
        r.ok(f"kitty {'.'.join(map(str, ver))}")
    for dep, why in (("jq", "session/JSON plumbing"), ("fzf", "pickers"), ("git", "branch & worktrees"),
                     ("python3", "tab bar helpers")):
        r.ok(dep) if shutil.which(dep) else r.fail(f"{dep} missing ({why})", f"install {dep}")
    for dep, why in (("notify-send", "desktop notifications when an agent waits"),
                     ("slangc", "dim unfocused panes (`kittymux dim`) and other kitty shaders"),
                     ("gh", "PR numbers in the deck"), ("ss", "listening ports in the deck")):
        r.ok(f"{dep} (optional)") if shutil.which(dep) else r.warning(f"{dep} not found — {why} disabled")

    print("\ninstall")
    on_path = shutil.which("kittymux")
    if on_path and os.path.realpath(on_path) == os.path.realpath(os.path.join(HOME_DIR, "bin", "kittymux")):
        r.ok(f"`kittymux` command on PATH ({on_path})")
    elif on_path:
        r.warning(f"`kittymux` on PATH is a different copy: {os.path.realpath(on_path)}", "run ./install.sh to point it at this checkout")
    else:
        r.warning("`kittymux` is not on your PATH", "run ./install.sh (it links ~/.local/bin/kittymux) and make sure ~/.local/bin is on PATH")
    conf = os.path.join(CFG, "kitty.conf")
    text = _conf_text(conf)
    if not text:
        r.fail(f"{conf} not found", "run ./install.sh")
    else:
        for needle, label in (("kittymux-keys.conf", "keybindings"), ("kittymux.conf", "core options")):
            if needle in text:
                r.ok(f"{label} included")
            else:
                r.fail(f"{label} not included by kitty.conf", "run ./install.sh")
        if re.search(r"^\s*watcher\s+\S*pane-state\.py", text, re.M):
            r.ok("pane-state watcher loaded (agent status)")
        else:
            r.fail("pane-state watcher not configured", "run ./install.sh (the keys conf adds it)")
        listen = re.search(r"^\s*listen_on\s+unix:(\S+)", text, re.M)
        if re.search(r"^\s*allow_remote_control\s+(yes|socket|socket-only)", text, re.M) and listen:
            r.ok("remote control + listen_on enabled")
            if listen.group(1).startswith("/tmp/"):
                r.warning("listen_on puts the control socket in /tmp, which any local user can write to",
                          "prefer  listen_on unix:${XDG_RUNTIME_DIR}/mykitty  (private 0700 directory; kittymux finds it there too)")
        else:
            r.warning("remote control may be off", "add to kitty.conf: allow_remote_control yes / listen_on unix:/tmp/mykitty")
    import glob as _glob
    for f in ["tab_bar.py"] + sorted(os.path.basename(g) for g in _glob.glob(os.path.join(HOME_DIR, "python", "kittymux_*.py"))):
        p = os.path.join(CFG, f)
        (r.ok(f"{f} → linked") if os.path.exists(p) else r.fail(f"{f} missing from {CFG}", "run ./install.sh"))
    fonts = _run(["fc-list", ":family=kittymux icons"])[1] if shutil.which("fc-list") else ""
    r.ok("brand icon font installed") if "kittymux" in fonts.lower() else \
        r.warning("brand icon font not found — agent logos will show as boxes", "run ./install.sh (copies it to ~/.local/share/fonts)")
    if os.path.isdir(STATE):
        mode = os.stat(STATE).st_mode & 0o777
        r.ok(f"state dir {STATE}") if mode == 0o700 else r.warning(f"state dir mode is {oct(mode)}", f"chmod 700 {STATE}")
    else:
        r.warning(f"state dir {STATE} missing", "it is created on first run of install.sh")

    print("\nlive kitty")
    socks = _sockets()
    if not socks:
        r.warning("no kitty remote-control socket found", "set listen_on unix:/tmp/mykitty and restart kitty")
    else:
        rc, out = _run(["kitty", "@", "--to", socks[0], "get-colors"])
        if rc == 0:
            p = kittymux_theme.from_colors(kittymux_theme.parse_kitty_colors(out))
            r.ok(f"connected ({socks[0]}); theme accent #{p.accent:06x}, bar #{p.bar:06x}")
        else:
            r.warning(f"could not query {socks[0]}", "is allow_remote_control on for that instance?")

    for sock in socks:
        pid = _socket_pid(sock)
        if pid is None:
            continue
        if binary_replaced(pid):
            r.warning(f"kitty {pid} was updated while it was running (its binary was replaced)",
                      "restart it when convenient: a running kitty mixes old code with the new install's Python files, "
                      "and clicks, drags and config reloads can misbehave until then (save sessions first: ctrl+alt+shift+s)")
        age = scanner_age(STATE, pid)
        if age is None:
            r.warning(f"agent scanner is not running in kitty {pid} (statuses fall back to hooks/titles)",
                      "reload that kitty twice (kittymux upgrade) — the tab bar starts the scanner on load")
        elif age > 10:
            r.warning(f"agent scanner in kitty {pid} last reported {age:.0f}s ago", "reload it twice (kittymux upgrade)")
        else:
            r.ok(f"agent scanner alive in kitty {pid}")

    elog = os.path.join(STATE, "tab_bar-error.log")
    if os.path.exists(elog) and os.path.getsize(elog) > 0:
        last = [l for l in open(elog, encoding="utf-8", errors="replace").read().splitlines() if l.strip()][-1]
        r.warning(f"the tab bar hit an error: {last[:110]}",
                  f"details in {elog} — fix, then reload with ctrl+shift+alt+r (clear the log afterwards)")
    else:
        r.ok("no tab bar errors logged")

    print("\nagent hooks (status dots, messages, notifications)")
    hooks_ok = False
    sj = os.path.expanduser("~/.claude/settings.json")
    if os.path.exists(sj) and "mux-status" in open(sj, encoding="utf-8", errors="replace").read():
        hooks_ok = True
        try:
            have = json.load(open(sj, encoding="utf-8")).get("hooks", {})
        except (OSError, ValueError):
            have = {}
        missing = [e for e in HOOK_EVENTS if not any("mux-status" in h.get("command", "") for g in have.get(e, [])
                                                     if isinstance(g, dict) for h in g.get("hooks", []))]
        if missing:
            r.warning(f"Claude Code hooks lack {', '.join(missing)}",
                      "run `kittymux hooks --install` (backs up settings.json first): Claude then reports a finished "
                      "tool call / ended session itself, so a quiet screen is never mistaken for a completion")
        else:
            r.ok("Claude Code hooks call mux-status (all events)")
    elif shutil.which("claude"):
        r.warning("Claude Code found but no mux-status hooks", "see README → Agent status hooks (or: kittymux hooks)")
    cx = os.path.expanduser("~/.codex/config.toml")
    if os.path.exists(cx) and "mux-status" in open(cx, encoding="utf-8", errors="replace").read():
        r.ok("Codex notify calls mux-status")
    if not hooks_ok and not shutil.which("claude"):
        r.ok("no hook-capable agents detected (heuristic status still works)")

    print("\nwindow manager")
    steals = kittymux_layout.hypr_focus_on_activate()
    if steals:
        if kittymux_layout.attention_allowed(kittymux_layout.state_dir(), steals):
            r.warning("Hyprland `misc:focus_on_activate` is on and kittymux attention requests are forced on",
                      "any bell then pulls focus to that window; remove `attention-on` from the state dir to let kittymux switch them off")
        else:
            r.ok("attention bells are off: Hyprland `misc:focus_on_activate` would turn a bell into a focus steal")
    conflicts = _hypr_conflicts()
    if shutil.which("hyprctl"):
        if conflicts:
            r.warning("Hyprland already binds: " + ", ".join(conflicts),
                      "those kittymux keys will never reach kitty — remap them in kittymux-keys.conf.tpl, or use leader mode (install.sh --leader)")
        else:
            r.ok("no ctrl+alt key conflicts with Hyprland")
    else:
        r.ok("no Hyprland detected (skipping key-conflict check)")

    print()
    if r.bad:
        print(f"{BAD} {r.bad} problem(s), {r.warn} warning(s)")
        return 1
    print(f"{OK} healthy" + (f" — {r.warn} optional warning(s)" if r.warn else ""))
    return 0


# ── demo ─────────────────────────────────────────────────────────────────────
