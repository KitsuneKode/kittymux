    "exact": [
      "resume",
      "{id}"
    ],
    "latest": [
      "resume",
      "--last"
    ],
    "probe": {
      "args": [
        "resume",
        "--help"
      ],
      "expect": [
        "--last",
        "SESSION_ID"
      ]
    },
    "latest_scope": "directory"
  },
