# kittymux template: review — an agent, the working-tree diff next to it, and a shell
# Placeholders: @NAME@ · @Q:CWD@ · @AGENT@ (default claude) · @SHELL@

new_tab @NAME@
layout splits
cd @Q:CWD@
launch --title @AGENT@ --var=kittymux_agent=@AGENT@ @AGENT@
launch --location=vsplit --title diff sh -c 'git status -sb; git diff --stat; exec @SHELL@'
launch --location=hsplit --title shell @SHELL@

focus_tab 0
